let customer_c_custkey = loadDiscrete('customer_c_custkey_cpd', [], [1500]) in
let customer_c_name = loadDiscrete('customer_c_name_cpd', [customer_c_custkey], [1500, 1500]) in
let customer_c_phone = loadDiscrete('customer_c_phone_cpd', [customer_c_custkey], [1500, 1500]) in
let customer_c_city = loadDiscrete('customer_c_city_cpd', [customer_c_phone], [250, 1500]) in
let customer_c_address = loadDiscrete('customer_c_address_cpd', [customer_c_phone], [1500, 1500]) in
let customer_c_nation = loadDiscrete('customer_c_nation_cpd', [customer_c_city], [25, 250]) in
let customer_c_region = loadDiscrete('customer_c_region_cpd', [customer_c_city], [5, 250]) in
let customer_c_mktsegment = loadDiscrete('customer_c_mktsegment_cpd', [customer_c_address], [5, 1500]) in
let supplier_s_suppkey = loadDiscrete('supplier_s_suppkey_cpd', [], [1495]) in
let supplier_s_name = loadDiscrete('supplier_s_name_cpd', [supplier_s_suppkey], [1495, 1495]) in
let supplier_s_phone = loadDiscrete('supplier_s_phone_cpd', [supplier_s_suppkey], [1495, 1495]) in
let supplier_s_city = loadDiscrete('supplier_s_city_cpd', [supplier_s_phone], [250, 1495]) in
let supplier_s_address = loadDiscrete('supplier_s_address_cpd', [supplier_s_phone], [1495, 1495]) in
let supplier_s_nation = loadDiscrete('supplier_s_nation_cpd', [supplier_s_city], [25, 250]) in
let supplier_s_region = loadDiscrete('supplier_s_region_cpd', [supplier_s_city], [5, 250]) in
let dwdate_d_datekey = loadDiscrete('dwdate_d_datekey_cpd', [], [1186]) in
let dwdate_d_date = loadDiscrete('dwdate_d_date_cpd', [dwdate_d_datekey], [1186, 1186]) in
let dwdate_d_yearmonthnum = loadDiscrete('dwdate_d_yearmonthnum_cpd', [dwdate_d_datekey], [84, 1186]) in
let dwdate_d_daynuminyear = loadDiscrete('dwdate_d_daynuminyear_cpd', [dwdate_d_date], [366, 1186]) in
let dwdate_d_daynuminmonth = loadDiscrete('dwdate_d_daynuminmonth_cpd', [dwdate_d_date], [31, 1186]) in
let dwdate_d_dayofweek = loadDiscrete('dwdate_d_dayofweek_cpd', [dwdate_d_date], [7, 1186]) in
let dwdate_d_lastdayinmonthfl = loadDiscrete('dwdate_d_lastdayinmonthfl_cpd', [dwdate_d_date], [2, 1186]) in
let dwdate_d_holidayfl = loadDiscrete('dwdate_d_holidayfl_cpd', [dwdate_d_date], [2, 1186]) in
let dwdate_d_weeknuminyear = loadDiscrete('dwdate_d_weeknuminyear_cpd', [dwdate_d_daynuminyear], [53, 366]) in
let dwdate_d_daynuminweek = loadDiscrete('dwdate_d_daynuminweek_cpd', [dwdate_d_dayofweek], [7, 7]) in
let dwdate_d_weekdayfl = loadDiscrete('dwdate_d_weekdayfl_cpd', [dwdate_d_dayofweek], [2, 7]) in
let dwdate_d_lastdayinweekfl = loadDiscrete('dwdate_d_lastdayinweekfl_cpd', [dwdate_d_dayofweek], [2, 7]) in
let dwdate_d_yearmonth = loadDiscrete('dwdate_d_yearmonth_cpd', [dwdate_d_yearmonthnum], [84, 84]) in
let dwdate_d_month = loadDiscrete('dwdate_d_month_cpd', [dwdate_d_yearmonthnum], [12, 84]) in
let dwdate_d_year = loadDiscrete('dwdate_d_year_cpd', [dwdate_d_yearmonthnum], [7, 84]) in
let dwdate_d_sellingseason = loadDiscrete('dwdate_d_sellingseason_cpd', [dwdate_d_yearmonthnum], [5, 84]) in
let dwdate_d_monthnuminyear = loadDiscrete('dwdate_d_monthnuminyear_cpd', [dwdate_d_month], [12, 12]) in
let lineorder_lo_orderkey = loadDiscrete('lineorder_lo_orderkey_cpd', [], [1500]) in
let lineorder_lo_ordertotalprice = loadDiscrete('lineorder_lo_ordertotalprice_cpd', [lineorder_lo_orderkey], [2000, 1500]) in
let lineorder_lo_revenue = loadDiscrete('lineorder_lo_revenue_cpd', [lineorder_lo_ordertotalprice], [2000, 2000]) in
let lineorder_lo_orderdate = loadDiscrete('lineorder_lo_orderdate_cpd', [lineorder_lo_ordertotalprice], [1414, 2000]) in
let lineorder_lo_suppkey = loadDiscrete('lineorder_lo_suppkey_cpd', [lineorder_lo_ordertotalprice], [1495, 2000]) in
let lineorder_lo_custkey = loadDiscrete('lineorder_lo_custkey_cpd', [lineorder_lo_ordertotalprice], [1499, 2000]) in
let lineorder_lo_linenumber = loadDiscrete('lineorder_lo_linenumber_cpd', [lineorder_lo_ordertotalprice], [7, 2000]) in
let lineorder_lo_shipmode = loadDiscrete('lineorder_lo_shipmode_cpd', [lineorder_lo_ordertotalprice], [7, 2000]) in
let lineorder_lo_orderpriority = loadDiscrete('lineorder_lo_orderpriority_cpd', [lineorder_lo_ordertotalprice], [5, 2000]) in
let lineorder_lo_extendedprice = loadDiscrete('lineorder_lo_extendedprice_cpd', [lineorder_lo_revenue], [2000, 2000]) in
let lineorder_lo_discount = loadDiscrete('lineorder_lo_discount_cpd', [lineorder_lo_revenue], [10, 2000]) in
let lineorder_lo_supplycost = loadDiscrete('lineorder_lo_supplycost_cpd', [lineorder_lo_extendedprice], [2000, 2000]) in
let lineorder_lo_quantity = loadDiscrete('lineorder_lo_quantity_cpd', [lineorder_lo_extendedprice], [50, 2000]) in
let lineorder_lo_partkey = loadDiscrete('lineorder_lo_partkey_cpd', [lineorder_lo_supplycost], [1499, 2000]) in
let lineorder_lo_tax = loadDiscrete('lineorder_lo_tax_cpd', [lineorder_lo_supplycost], [9, 2000]) in

let customer_c_city_ = select customer_c_city [128, 179] in
let customerProb0 = query [customer_c_custkey, customer_c_city] [customer_c_city_] [] [] in
let lineorder_nrows = 300005884 in
let dwdate_nrows = 2556 in
let customer_nrows = 1500000 in
let supplier_nrows = 100000 in
let dwdate_nrows = dwdate_nrows * lineorder_nrows in
let customer_nrows = customer_nrows * dwdate_nrows in
let nrows = supplier_nrows * customer_nrows in
let supplier_s_city_ = select supplier_s_city [72, 165] in
let supplierProb0 = query [supplier_s_suppkey, supplier_s_city] [supplier_s_city_] [] [] in
let dwdate_d_year_ = select dwdate_d_year [0, 1, 2, 3, 4, 5] in
let dwdateProb0 = query [dwdate_d_datekey, dwdate_d_year] [dwdate_d_year_] [] [] in
let lineorderProb0 = query [lineorder_lo_custkey, lineorder_lo_orderdate, lineorder_lo_suppkey, lineorder_lo_revenue] [] [] [] in

let lineorder_lo_revenue_m = loadTensor('lineorder_lo_revenue_m', [2000]) in
let m3_lineorder_customer = loadTensor('lineorder_lo_custkey_customer_c_custkey_pkfk', [1499, 1500]) in
let m3_lineorder_supplier = loadTensor('lineorder_lo_suppkey_supplier_s_suppkey_pkfk', [1495, 1495]) in
let m3_lineorder_dwdate = loadTensor('lineorder_lo_orderdate_dwdate_d_datekey_pkfk', [1414, 1186]) in
let lineorderProb0_0 = outer lineorderProb0 customerProb0 in
let lineorderProb0_1 = expectation [lineorder_lo_orderdate, lineorder_lo_suppkey, lineorder_lo_revenue, customer_c_city] lineorderProb0_0 m3_lineorder_customer [0, 4] in
let lineorderProb0_2 = outer lineorderProb0_1 supplierProb0 in
let lineorderProb0_3 = expectation [lineorder_lo_orderdate, lineorder_lo_revenue, customer_c_city, supplier_s_city] lineorderProb0_2 m3_lineorder_supplier [1, 4] in
let lineorderProb0_4 = outer lineorderProb0_3 dwdateProb0 in
let lineorderProb0_5 = expectation [lineorder_lo_revenue, customer_c_city, supplier_s_city, dwdate_d_year] lineorderProb0_4 m3_lineorder_dwdate [0, 4] in

let lineorderProb0_5Norm = normalize lineorderProb0_5 [1, 2, 3] in
let exp_lo_revenue = expectation [lineorder_lo_revenue,customer_c_city,supplier_s_city,dwdate_d_year] lineorderProb0_5Norm lineorder_lo_revenue_m [0] in

let lineorderProb0_5_exp_count = expectation [customer_c_city, supplier_s_city, dwdate_d_year] lineorderProb0_5 exp_lo_revenue [0, 1, 2, 3] in
let sum_lo_revenue = lineorderProb0_5_exp_count * nrows in

let dwdate_d_year = loadTensor('dwdate_d_year_idxmat', [7, 7]) in
let dwdate_d_year = filter dwdate_d_year [0, 1, 2, 3, 4, 5] in
let sum_lo_revenue_decompress0 = decompress sum_lo_revenue dwdate_d_year [d_year] in
let dwdate_d_year_b2v = loadDictionary('dwdate_d_year_b2v', [7, 7]) in

let supplier_s_city = loadTensor('supplier_s_city_idxmat', [250, 250]) in
let supplier_s_city = filter supplier_s_city [72, 165] in
let sum_lo_revenue_decompress1 = decompress sum_lo_revenue_decompress0 supplier_s_city [s_city] in
let supplier_s_city_b2v = loadDictionary('supplier_s_city_b2v', [250, 250]) in

let customer_c_city = loadTensor('customer_c_city_idxmat', [250, 250]) in
let customer_c_city = filter customer_c_city [128, 179] in
let sum_lo_revenue_decompress2 = decompress sum_lo_revenue_decompress1 customer_c_city [c_city] in
let customer_c_city_b2v = loadDictionary('customer_c_city_b2v', [250, 250]) in

let sum_lo_revenue_rev = map sum_lo_revenue_decompress2 [customer_c_city_b2v, supplier_s_city_b2v, dwdate_d_year_b2v] in
let sum_lo_revenue_rev_lift = lift sum_lo_revenue_rev in
sum_lo_revenue_rev_lift