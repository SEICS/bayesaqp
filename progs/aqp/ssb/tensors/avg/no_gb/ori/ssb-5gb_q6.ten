let lo_suppkey_s_suppkey = load('lo_suppkey_s_suppkey', [], [150,150])
let lo_orderdate_d_datekey = load('lo_orderdate_d_datekey', [], [148,147])
let lineorderPr_0 = contract('ostq,a->ostqa', lineorderProb, customerProb)
let lineorderPr_1 = contract('ostqa,ta->qos', lineorderPr_0, lo_custkey_c_custkey)
let lineorderPr_1 = contract('qos,e->qose', lineorderPr_1, supplierProb)
let lineorderPr_2 = contract('qose,oe->qs', lineorderPr_1, lo_suppkey_s_suppkey)
let lineorderPr_2 = contract('qs,i->qsi', lineorderPr_2, dwdateProb)
let lineorderPr_3 = contract('qsi,si->q', lineorderPr_2, lo_orderdate_d_datekey)
let lineorderPr_3Norm = normalize(lineorderPr_3, [])
let exp_lo_revenue = contract('q,q->', lineorderPr_3Norm, lo_revenue_m)
