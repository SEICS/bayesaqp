let lo_orderkey = loadDiscrete('lo_orderkey', [], [150]) in
let lo_ordertotalprice = loadDiscrete('lo_ordertotalprice', [lo_orderkey], [200, 150]) in
let lo_revenue = loadDiscrete('lo_revenue', [lo_ordertotalprice], [200, 200]) in
let lo_orderdate = loadDiscrete('lo_orderdate', [lo_ordertotalprice], [149, 200]) in
let lo_custkey = loadDiscrete('lo_custkey', [lo_ordertotalprice], [150, 200]) in
let lo_suppkey = loadDiscrete('lo_suppkey', [lo_ordertotalprice], [150, 200]) in
let lo_extendedprice = loadDiscrete('lo_extendedprice', [lo_revenue], [200, 200]) in
let lo_discount = loadDiscrete('lo_discount', [lo_revenue], [10, 200]) in
let lo_quantity = loadDiscrete('lo_quantity', [lo_extendedprice], [50, 200]) in
let lo_supplycost = loadDiscrete('lo_supplycost', [lo_extendedprice], [200, 200]) in
let lo_partkey = loadDiscrete('lo_partkey', [lo_supplycost], [150, 200]) in

let lo_discount_m = loadTensor('lo_discount_m', [10]) in
let lineorderProb = query [lo_discount] [] [] [] in

let lineorderProbNorm = normalize lineorderProb [] in
let exp_lo_discount = expectation [] lineorderProbNorm lo_discount_m [0] in
exp_lo_discount