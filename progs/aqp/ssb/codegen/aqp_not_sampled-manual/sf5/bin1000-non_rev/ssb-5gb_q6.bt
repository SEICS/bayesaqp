let c_custkey = loadDiscrete('c_custkey', [], [1497]) in
let c_name = loadDiscrete('c_name', [c_custkey], [1497, 1497]) in
let c_address = loadDiscrete('c_address', [c_custkey], [1497, 1497]) in
let c_phone = loadDiscrete('c_phone', [c_custkey], [1497, 1497]) in
let c_mktsegment = loadDiscrete('c_mktsegment', [c_address], [5, 1497]) in
let c_city = loadDiscrete('c_city', [c_phone], [250, 1497]) in
let c_nation = loadDiscrete('c_nation', [c_city], [25, 250]) in
let c_region = loadDiscrete('c_region', [c_nation], [5, 25]) in
let s_suppkey = loadDiscrete('s_suppkey', [], [1450]) in
let s_name = loadDiscrete('s_name', [s_suppkey], [1450, 1450]) in
let s_phone = loadDiscrete('s_phone', [s_suppkey], [1450, 1450]) in
let s_address = loadDiscrete('s_address', [s_phone], [1450, 1450]) in
let s_city = loadDiscrete('s_city', [s_phone], [250, 1450]) in
let s_nation = loadDiscrete('s_nation', [s_city], [25, 250]) in
let s_region = loadDiscrete('s_region', [s_city], [5, 250]) in
let d_datekey = loadDiscrete('d_datekey', [], [1186]) in
let d_date = loadDiscrete('d_date', [d_datekey], [1186, 1186]) in
let d_yearmonthnum = loadDiscrete('d_yearmonthnum', [d_datekey], [84, 1186]) in
let d_daynuminyear = loadDiscrete('d_daynuminyear', [d_date], [366, 1186]) in
let d_daynuminmonth = loadDiscrete('d_daynuminmonth', [d_date], [31, 1186]) in
let d_dayofweek = loadDiscrete('d_dayofweek', [d_date], [7, 1186]) in
let d_lastdayinmonthfl = loadDiscrete('d_lastdayinmonthfl', [d_date], [2, 1186]) in
let d_holidayfl = loadDiscrete('d_holidayfl', [d_date], [2, 1186]) in
let d_weeknuminyear = loadDiscrete('d_weeknuminyear', [d_daynuminyear], [53, 366]) in
let d_daynuminweek = loadDiscrete('d_daynuminweek', [d_dayofweek], [7, 7]) in
let d_weekdayfl = loadDiscrete('d_weekdayfl', [d_dayofweek], [2, 7]) in
let d_lastdayinweekfl = loadDiscrete('d_lastdayinweekfl', [d_dayofweek], [2, 7]) in
let d_yearmonth = loadDiscrete('d_yearmonth', [d_yearmonthnum], [84, 84]) in
let d_month = loadDiscrete('d_month', [d_yearmonthnum], [12, 84]) in
let d_year = loadDiscrete('d_year', [d_yearmonthnum], [7, 84]) in
let d_sellingseason = loadDiscrete('d_sellingseason', [d_yearmonthnum], [5, 84]) in
let d_monthnuminyear = loadDiscrete('d_monthnuminyear', [d_month], [12, 12]) in
let lo_orderkey = loadDiscrete('lo_orderkey', [], [1500]) in
let lo_ordertotalprice = loadDiscrete('lo_ordertotalprice', [lo_orderkey], [2000, 1500]) in
let lo_orderdate = loadDiscrete('lo_orderdate', [lo_ordertotalprice], [1453, 2000]) in
let lo_custkey = loadDiscrete('lo_custkey', [lo_ordertotalprice], [1495, 2000]) in
let lo_revenue = loadDiscrete('lo_revenue', [lo_ordertotalprice], [2000, 2000]) in
let lo_extendedprice = loadDiscrete('lo_extendedprice', [lo_revenue], [2000, 2000]) in
let lo_suppkey = loadDiscrete('lo_suppkey', [lo_revenue], [1450, 2000]) in
let lo_discount = loadDiscrete('lo_discount', [lo_revenue], [10, 2000]) in
let lo_supplycost = loadDiscrete('lo_supplycost', [lo_extendedprice], [2000, 2000]) in
let lo_quantity = loadDiscrete('lo_quantity', [lo_extendedprice], [50, 2000]) in
let lo_partkey = loadDiscrete('lo_partkey', [lo_supplycost], [1499, 2000]) in

let c_region_ = select c_region [1] in
let customerProb = query [c_custkey,c_nation] [c_region_] [] [] in
let lineorder_nrows = 29999795 in
let dwdate_nrows = 2556 in
let customer_nrows = 150000 in
let supplier_nrows = 10000 in
let dwdate_nrows = dwdate_nrows * lineorder_nrows in
let customer_nrows = customer_nrows * dwdate_nrows in
let nrows = supplier_nrows * customer_nrows in
let s_region_ = select s_region [2] in
let supplierProb = query [s_suppkey,s_nation] [s_region_] [] [] in
let d_year_ = select d_year [0, 1, 2, 3, 4, 5] in
let dwdateProb = query [d_datekey,d_year] [d_year_] [] [] in
let lineorderProb = query [lo_orderdate,lo_custkey,lo_suppkey,lo_revenue] [] [] [] in

let lo_revenue_m = loadTensor('lo_revenue_m', [2000]) in
let m3_lineorder_customer = loadTensor('lo_custkey_c_custkey', [1495, 1497]) in
let m3_lineorder_supplier = loadTensor('lo_suppkey_s_suppkey', [1450, 1450]) in
let m3_lineorder_dwdate = loadTensor('lo_orderdate_d_datekey', [1453, 1186]) in
let lineorderPr_0 = outer lineorderProb customerProb in
let lineorderPr_1 = expectation [lo_revenue,lo_suppkey,lo_orderdate,c_nation] lineorderPr_0 m3_lineorder_customer [1, 4] in
let lineorderPr_1 = outer lineorderPr_1 supplierProb in
let lineorderPr_2 = expectation [lo_revenue,lo_orderdate,c_nation,s_nation] lineorderPr_1 m3_lineorder_supplier [1, 4] in
let lineorderPr_2 = outer lineorderPr_2 dwdateProb in
let lineorderPr_3 = expectation [lo_revenue,c_nation,s_nation,d_year] lineorderPr_2 m3_lineorder_dwdate [1, 4] in

let lineorderPr_3Norm = normalize lineorderPr_3 [1,2,3] in
let exp_lo_revenue = expectation [lo_revenue,c_nation,s_nation,d_year] lineorderPr_3Norm lo_revenue_m [0] in

let count_exp_lo_revenue = expectation [c_nation,s_nation,d_year] exp_lo_revenue lineorderPr_3  [0,1,2,3] in
let sum_lo_revenue = nrows * count_exp_lo_revenue in

sum_lo_revenue