let earthquake  = discrete [0.9999, 0.0001] in
let burglary  = discrete [0.999, 0.001] in
let alarm  = match (earthquake,burglary) with {
    (0,0) -> discrete [1, 0]
  | (0,1) -> discrete [0, 1]
  | (1,0) -> discrete [0, 1]
  | (1,1) -> discrete [0, 1]
} in
let phoneWorking  = match earthquake with {
    0 -> discrete [0.01, 0.99]
  | 1 -> discrete [0.3, 0.7]
} in
let maryWakes  = match (alarm,earthquake) with {
    (0,0) -> discrete [0.8, 0.2]
  | (0,1) -> discrete [0.8, 0.2]
  | (1,0) -> discrete [0.4, 0.6]
  | (1,1) -> discrete [0.2, 0.8]
} in
let called  = match (maryWakes,phoneWorking) with {
    (0,0) -> discrete [1, 0]
  | (0,1) -> discrete [1, 0]
  | (1,0) -> discrete [1, 0]
  | (1,1) -> discrete [0, 1]
} in
let obsCalled = observe called [1] in
query [burglary] [] [obsCalled]