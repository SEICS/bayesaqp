let title_id = loadDiscrete('title_id_cpd', [], [1500]) in
let title_kind_id = loadDiscrete('title_kind_id_cpd', [title_id], [11, 1500]) in
let title_production_year = loadDiscrete('title_production_year_cpd', [title_id], [132, 1500]) in
let movie_info_id = loadDiscrete('movie_info_id_cpd', [], [1500]) in
let movie_info_movie_id = loadDiscrete('movie_info_movie_id_cpd', [movie_info_id], [1500, 1500]) in
let movie_info_info_type_id = loadDiscrete('movie_info_info_type_id_cpd', [movie_info_id], [71, 1500]) in
let movie_info_idx_id = loadDiscrete('movie_info_idx_id_cpd', [], [1500]) in
let movie_info_idx_movie_id = loadDiscrete('movie_info_idx_movie_id_cpd', [movie_info_idx_id], [1499, 1500]) in
let movie_info_idx_info_type_id = loadDiscrete('movie_info_idx_info_type_id_cpd', [movie_info_idx_id], [5, 1500]) in
let movie_keyword_id = loadDiscrete('movie_keyword_id_cpd', [], [1500]) in
let movie_keyword_movie_id = loadDiscrete('movie_keyword_movie_id_cpd', [movie_keyword_id], [1494, 1500]) in
let movie_keyword_keyword_id = loadDiscrete('movie_keyword_keyword_id_cpd', [movie_keyword_movie_id], [1444, 1494]) in
let movie_companies_id = loadDiscrete('movie_companies_id_cpd', [], [1500]) in
let movie_companies_movie_id = loadDiscrete('movie_companies_movie_id_cpd', [movie_companies_id], [1500, 1500]) in
let movie_companies_company_id = loadDiscrete('movie_companies_company_id_cpd', [movie_companies_id], [1467, 1500]) in
let movie_companies_company_type_id = loadDiscrete('movie_companies_company_type_id_cpd', [movie_companies_id], [2, 1500]) in

let movie_info_info_type_id_ = select movie_info_info_type_id [3] in
let movie_infoProb0 = query [movie_info_movie_id] [movie_info_info_type_id_] [] [] in
let title_nrows = 3486660 in
let movie_info_nrows = 24988000 in
let movie_companies_nrows = 4958300 in
let movie_keyword_nrows = 7522600 in
let movie_info_idx_nrows = 3147110 in
let movie_info_nrows = movie_info_nrows * title_nrows in
let movie_companies_nrows = movie_companies_nrows * movie_info_nrows in
let movie_keyword_nrows = movie_keyword_nrows * movie_companies_nrows in
let nrows = movie_info_idx_nrows * movie_keyword_nrows in
let movie_info_idx_info_type_id_ = select movie_info_idx_info_type_id [2] in
let movie_info_idxProb0 = query [movie_info_idx_movie_id] [movie_info_idx_info_type_id_] [] [] in
let movie_keywordProb0 = query [movie_keyword_movie_id] [] [] [] in
let movie_companiesProb0 = query [movie_companies_movie_id] [] [] [] in
let title_production_year_ = select title_production_year [0, 1, 2, 130, 10, 78, 119, 122, 127] in
let titleProb0 = query [title_id] [title_production_year_] [] [] in
let m3_title_movie_info = loadTensor('title_id_movie_info_movie_id_pkfk', [1500, 1500]) in
let m3_title_movie_info_idx = loadTensor('title_id_movie_info_idx_movie_id_pkfk', [1500, 1499]) in
let m3_title_movie_keyword = loadTensor('title_id_movie_keyword_movie_id_pkfk', [1500, 1494]) in
let m3_title_movie_companies = loadTensor('title_id_movie_companies_movie_id_pkfk', [1500, 1500]) in
let titleProb0_0 = outer titleProb0 movie_keywordProb0 in
let titleProb0_1 = expectation [title_id] titleProb0_0 m3_title_movie_keyword [0, 1] in
let titleProb0_2 = outer titleProb0_1 movie_info_idxProb0 in
let titleProb0_3 = expectation [title_id] titleProb0_2 m3_title_movie_info_idx [0, 1] in
let titleProb0_4 = outer titleProb0_3 movie_infoProb0 in
let titleProb0_5 = expectation [title_id] titleProb0_4 m3_title_movie_info [0, 1] in
let titleProb0_6 = outer titleProb0_5 movie_companiesProb0 in
let titleProb0_7 = expectation [] titleProb0_6 m3_title_movie_companies [0, 1] in

let titleProb0_7_tensor = tensor titleProb0_7 in
let count_ = nrows * titleProb0_7_tensor in

count_