let lo_orderkey = loadDiscrete('lo_orderkey', [], [1500]) in
let lo_ordertotalprice = loadDiscrete('lo_ordertotalprice', [lo_orderkey], [2000, 1500]) in
let lo_orderdate = loadDiscrete('lo_orderdate', [lo_ordertotalprice], [1453, 2000]) in
let lo_custkey = loadDiscrete('lo_custkey', [lo_ordertotalprice], [1495, 2000]) in
let lo_revenue = loadDiscrete('lo_revenue', [lo_ordertotalprice], [2000, 2000]) in
let lo_extendedprice = loadDiscrete('lo_extendedprice', [lo_revenue], [2000, 2000]) in
let lo_suppkey = loadDiscrete('lo_suppkey', [lo_revenue], [1450, 2000]) in
let lo_discount = loadDiscrete('lo_discount', [lo_revenue], [10, 2000]) in
let lo_supplycost = loadDiscrete('lo_supplycost', [lo_extendedprice], [2000, 2000]) in
let lo_quantity = loadDiscrete('lo_quantity', [lo_extendedprice], [50, 2000]) in
let lo_partkey = loadDiscrete('lo_partkey', [lo_supplycost], [1499, 2000]) in

let lo_quantity_ = select lo_quantity [3, 36, 38, 40, 15, 17, 19, 22, 26, 29] in 
let lineorderProb = query [lo_revenue] [lo_quantity_] [] [] in
let lineorderProbNorm = normalize lineorderProb [] in

let lo_revenue_m = loadTensor('lo_revenue_m', [2000]) in
let avg_gb = expectation [] lineorderProbNorm lo_revenue_m [0] in

let count_uni = unitMat lineorderProb in
let count_gb = expectation [] lineorderProb count_uni [0] in
let count_exp_gb = count_gb * avg_gb in

let nrows = 29999795 in
let sum_no_gb = nrows * count_exp_gb in
sum_no_gb