let c_custkey = load('c_custkey', [], [150])
let c_city = load('c_city', [c_custkey], [131,150])
let c_nation = load('c_nation', [c_city], [25,131])
let c_region = select(load('c_region', [c_nation], [5,25]), [1], 0)
let res2 = contract('a,ba,cb,dc->ac', c_custkey, c_city, c_nation, c_region)
let customerProb = res2
let lineorder_nrows = tensor(0, [], [26662.0])
let supplier_nrows = tensor(0, [], [10000.0])
let customer_nrows = tensor(0, [], [150000.0])
let dwdate_nrows = tensor(0, [], [2556.0])
let supplier_nrows = contract(',->', supplier_nrows, lineorder_nrows)
let customer_nrows = contract(',->', customer_nrows, supplier_nrows)
let nrows = contract(',->', dwdate_nrows, customer_nrows)
let s_suppkey = load('s_suppkey', [], [150])
let s_city = load('s_city', [s_suppkey], [131,150])
let s_nation = load('s_nation', [s_city], [25,131])
let s_region = select(load('s_region', [s_nation], [5,25]), [2], 0)
let res4 = contract('e,fe,gf,hg->eg', s_suppkey, s_city, s_nation, s_region)
let supplierProb = res4
let d_datekey = load('d_datekey', [], [147])
let d_yearmonth = load('d_yearmonth', [d_datekey], [80,147])
let d_yearmonthnum = load('d_yearmonthnum', [d_yearmonth], [77,80])
let d_year = select(load('d_year', [d_yearmonthnum], [7,77]), [0, 1, 2, 3, 4, 5], 0)
let res6 = contract('i,ji,kj,lk->il', d_datekey, d_yearmonth, d_yearmonthnum, d_year)
let dwdateProb = res6
let lo_orderkey = load('lo_orderkey', [], [150])
let lo_supplycost = load('lo_supplycost', [lo_orderkey], [200,150])
let lo_extendedprice = load('lo_extendedprice', [lo_supplycost], [200,200])
let lo_revenue = load('lo_revenue', [lo_extendedprice], [200,200])
let lo_custkey = load('lo_custkey', [lo_revenue], [150,200])
let lo_suppkey = load('lo_suppkey', [lo_supplycost], [150,200])
let lo_ordertotalprice = load('lo_ordertotalprice', [lo_revenue], [200,200])
let lo_orderdate = load('lo_orderdate', [lo_ordertotalprice], [148,200])
let res8 = contract('m,nm,on,po,qp,rn,sp,ts->qrtp', lo_orderkey, lo_supplycost, lo_extendedprice, lo_revenue, lo_custkey, lo_suppkey, lo_ordertotalprice, lo_orderdate)
let lineorderProb = res8
let lo_revenue_m = load('lo_revenue_m', [], [200])
let lo_custkey_c_custkey = load('lo_custkey_c_custkey', [], [150,150])
let lo_suppkey_s_suppkey = load('lo_suppkey_s_suppkey', [], [150,150])
let lo_orderdate_d_datekey = load('lo_orderdate_d_datekey', [], [148,147])
let lineorderPr_0 = contract('qrtp,ac->qrtpac', lineorderProb, customerProb)
let lineorderPr_1 = contract('qrtpac,qa->prtc', lineorderPr_0, lo_custkey_c_custkey)
let lineorderPr_1 = contract('prtc,eg->prtceg', lineorderPr_1, supplierProb)
let lineorderPr_2 = contract('prtceg,re->ptcg', lineorderPr_1, lo_suppkey_s_suppkey)
let lineorderPr_2 = contract('ptcg,il->ptcgil', lineorderPr_2, dwdateProb)
let lineorderPr_3 = contract('ptcgil,ti->pcgl', lineorderPr_2, lo_orderdate_d_datekey)

let customer_c_nation = load('customer_c_nation', [], [25,25])
let supplier_s_nation = load('supplier_s_nation', [], [25,25])
let dwdate_d_year = load('dwdate_d_year', [], [7,7])
let dwdate_d_year = select(dwdate_d_year, [0, 1, 2, 3, 4, 5], 0)
let lineorderPr_4 = contract('pcgl,cx,gy,lz->pxyz', lineorderPr_3, customer_c_nation, supplier_s_nation, dwdate_d_year)

let lineorderPr_4Norm = normalize(lineorderPr_4, [1,2,3])
let exp_lo_revenue = contract('pxyz,p->xyz', lineorderPr_4Norm, lo_revenue_m)
exp_lo_revenue
