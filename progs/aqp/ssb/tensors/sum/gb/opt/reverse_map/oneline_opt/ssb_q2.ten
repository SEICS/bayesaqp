let res4 = contract('g,hg,ih,ji,kj,lk,mj,ni,ad,la,dt,i,m,->t', lo_orderkey, lo_supplycost, lo_extendedprice, lo_revenue, lo_ordertotalprice, lo_orderdate, lo_discount, lo_quantity, dwdateProb, lo_orderdate_d_datekey, dwdate_d_year, lo_extendedprice_m, lo_discount_m, nrows)
