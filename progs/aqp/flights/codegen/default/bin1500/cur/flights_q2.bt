let year_date = loadDiscrete('year_date', [], [22]) in
let distance = loadDiscrete('distance', [year_date], [3000, 22]) in
let air_time = loadDiscrete('air_time', [distance], [1862, 3000]) in
let arr_delay = loadDiscrete('arr_delay', [distance], [966, 3000]) in
let taxi_out = loadDiscrete('taxi_out', [distance], [427, 3000]) in
let taxi_in = loadDiscrete('taxi_in', [distance], [256, 3000]) in
let dest = loadDiscrete('dest', [distance], [362, 3000]) in
let origin = loadDiscrete('origin', [distance], [361, 3000]) in
let unique_carrier = loadDiscrete('unique_carrier', [distance], [26, 3000]) in
let dep_delay = loadDiscrete('dep_delay', [arr_delay], [750, 966]) in
let dest_state_abr = loadDiscrete('dest_state_abr', [dest], [53, 362]) in
let origin_state_abr = loadDiscrete('origin_state_abr', [origin], [53, 361]) in

let origin_state_abr_ = select origin_state_abr [24] in
let flightsProb0 = query [unique_carrier] [origin_state_abr_] [] [] in
let nrows = 500000 in
let flightsProb0_tensor = tensor flightsProb0 in
let count_ = nrows * flightsProb0_tensor in

let flights_unique_carrier_b2v = loadDictionary('flights_unique_carrier_b2v', [26, 26]) in

let count_rev = map count_ [flights_unique_carrier_b2v] in
let count_rev_lift = lift count_rev in
count_rev_lift