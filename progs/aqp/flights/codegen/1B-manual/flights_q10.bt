let year_date = loadDiscrete('year_date', [], [22]) in
let distance = loadDiscrete('distance', [year_date], [3000, 22]) in
let air_time = loadDiscrete('air_time', [distance], [1859, 3000]) in
let arr_delay = loadDiscrete('arr_delay', [distance], [971, 3000]) in
let taxi_out = loadDiscrete('taxi_out', [distance], [428, 3000]) in
let origin = loadDiscrete('origin', [distance], [372, 3000]) in
let dest = loadDiscrete('dest', [distance], [371, 3000]) in
let taxi_in = loadDiscrete('taxi_in', [distance], [255, 3000]) in
let unique_carrier = loadDiscrete('unique_carrier', [distance], [26, 3000]) in
let dep_delay = loadDiscrete('dep_delay', [arr_delay], [752, 971]) in
let origin_state_abr = loadDiscrete('origin_state_abr', [origin], [53, 372]) in
let dest_state_abr = loadDiscrete('dest_state_abr', [dest], [53, 371]) in

let origin_state_abr_ = select origin_state_abr [0] in
let dest_state_abr_ = select dest_state_abr [23] in
let flightsProb = query [arr_delay,dep_delay,year_date] [origin_state_abr_,dest_state_abr_] [] [] in

let arr_delay_m = loadTensor('arr_delay_m', [971]) in
let dep_delay_m = loadTensor('dep_delay_m', [752]) in
let nrows = 1000271700 in
let flightsProbNorm = normalize flightsProb [2] in
let ms0 = outer arr_delay_m dep_delay_m in
let exp_arr_delay_dep_delay = expectation [year_date] flightsProbNorm ms0 [0, 1] in

let flightsProb_um = unitMat flightsProb in
let flightsProb_count = expectation [year_date] flightsProb flightsProb_um [0, 1, 2] in
let count_arr_delay_dep_delay = nrows * flightsProb_count in
let sum_arr_delay_dep_delay = exp_arr_delay_dep_delay * count_arr_delay_dep_delay in

let flights_year_date_b2v = loadDictionary('flights_year_date_b2v', [22,22]) in
let res1_rev = map sum_arr_delay_dep_delay [flights_year_date_b2v] in
let res1_rev_lift = lift res1_rev in
res1_rev_lift