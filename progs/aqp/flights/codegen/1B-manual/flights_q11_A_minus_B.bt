let year_date = loadDiscrete('year_date', [], [22]) in
let distance = loadDiscrete('distance', [year_date], [3000, 22]) in
let air_time = loadDiscrete('air_time', [distance], [1859, 3000]) in
let arr_delay = loadDiscrete('arr_delay', [distance], [971, 3000]) in
let taxi_out = loadDiscrete('taxi_out', [distance], [428, 3000]) in
let origin = loadDiscrete('origin', [distance], [372, 3000]) in
let dest = loadDiscrete('dest', [distance], [371, 3000]) in
let taxi_in = loadDiscrete('taxi_in', [distance], [255, 3000]) in
let unique_carrier = loadDiscrete('unique_carrier', [distance], [26, 3000]) in
let dep_delay = loadDiscrete('dep_delay', [arr_delay], [752, 971]) in
let origin_state_abr = loadDiscrete('origin_state_abr', [origin], [53, 372]) in
let dest_state_abr = loadDiscrete('dest_state_abr', [dest], [53, 371]) in
let unique_carrier_ = select unique_carrier [3] in
let origin_ = select origin [0] in
let flights_expProb0 = query [taxi_out,dest_state_abr] [unique_carrier_,origin_] [] [] in
let flights_expProb0Norm = normalize flights_expProb0 [1] in
let taxi_out_m = loadTensor('taxi_out_m', [428]) in
let exp0 = expectation [dest_state_abr] flights_expProb0Norm taxi_out_m [0] in
let unitMatrix0 = unitMat flights_expProb0 in
let flights_prob0 = expectation [dest_state_abr] flights_expProb0 unitMatrix0 [0,1] in
let nrows = 1000271700 in
let count0 = nrows * flights_prob0 in
let res0 = exp0 * count0 in
let unique_carrier_ = select unique_carrier [3] in
let origin_ = select origin [0] in
let flights_expProb1 = query [taxi_in,dest_state_abr] [unique_carrier_,origin_] [] [] in
let flights_expProb1Norm = normalize flights_expProb1 [1] in
let taxi_in_m = loadTensor('taxi_in_m', [255]) in
let exp1 = expectation [dest_state_abr] flights_expProb1Norm taxi_in_m [0] in
let unitMatrix1 = unitMat flights_expProb1 in
let flights_prob1 = expectation [dest_state_abr] flights_expProb1 unitMatrix1 [0,1] in
let nrows = 1000271700 in
let count1 = nrows * flights_prob1 in
let res1 = exp1 * count1 in
let res = res0 - res1 in
res