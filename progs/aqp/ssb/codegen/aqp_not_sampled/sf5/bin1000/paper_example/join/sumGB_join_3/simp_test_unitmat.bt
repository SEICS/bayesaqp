let customer = query [c_custkey, c_city] [c_nation_] [] [] in
let supplier = query [s_suppkey, s_city] [s_nation_] [] [] in
let dwdate = query [d_datekey, d_year] [d_year_] [] [] in
let lineorder = query [lo_custkey, lo_suppkey, lo_orderdate, lo_revenue] [] [] [] in

let prep1 = outer lineorder customer in
let join1 = expectation [lo_suppkey, lo_orderdate, lo_revenue, c_city] prep1 rho1 [0, 4] in
let prep2 = outer join1 supplier in
let join2 = expectation [lo_orderdate, lo_revenue, c_city, s_city] prep2 rho2 [0, 4] in
let prep3 = outer join2 dwdate in
let join3 = expectation [lo_revenue, c_city, s_city, d_year] prep3 rho3 [0, 4] in

let join3Norm = normalize join3 [1, 2, 3] in
let exp_lo_revenue = expectation [lo_revenue,c_city,s_city,d_year] join3Norm lo_revenue_m [0] in

let join3_exp_count = expectation [c_city, s_city, d_year] join3 exp_lo_revenue [0, 1, 2, 3] in

let ones = unitMat join3 in
let countProb = expectation [c_city, s_city, d_year] join3 ones [0, 1, 2, 3] in
let countGB = countProb * nrows in

let sum_lo_revenue = exp_lo_revenu * countGB in
