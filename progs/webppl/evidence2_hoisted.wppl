// http://webppl.org/
var prog = function() {
  var evidence = flip(0.5);
  if(evidence) {
    var coin1 = flip(0.5);
    condition(coin1);
    return coin1;
  } else {
    return flip(0.5);
  }
}

var dist = Infer(
  {method: 'enumerate', maxExecutions: 1000000},
  prog);

print(dist);
// {"probs":[0.6666666666666666,0.33333333333333337],"support":[true,false]}
