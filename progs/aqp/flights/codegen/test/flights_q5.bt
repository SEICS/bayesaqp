let flights_year_date = loadDiscrete('flights_year_date_cpd', [], [22]) in
let flights_distance = loadDiscrete('flights_distance_cpd', [flights_year_date], [3000, 22]) in
let flights_air_time = loadDiscrete('flights_air_time_cpd', [flights_distance], [1858, 3000]) in
let flights_arr_delay = loadDiscrete('flights_arr_delay_cpd', [flights_distance], [971, 3000]) in
let flights_taxi_out = loadDiscrete('flights_taxi_out_cpd', [flights_distance], [428, 3000]) in
let flights_origin = loadDiscrete('flights_origin_cpd', [flights_distance], [372, 3000]) in
let flights_dest = loadDiscrete('flights_dest_cpd', [flights_distance], [372, 3000]) in
let flights_taxi_in = loadDiscrete('flights_taxi_in_cpd', [flights_distance], [255, 3000]) in
let flights_unique_carrier = loadDiscrete('flights_unique_carrier_cpd', [flights_distance], [26, 3000]) in
let flights_dep_delay = loadDiscrete('flights_dep_delay_cpd', [flights_arr_delay], [750, 971]) in
let flights_origin_state_abr = loadDiscrete('flights_origin_state_abr_cpd', [flights_origin], [53, 372]) in
let flights_dest_state_abr = loadDiscrete('flights_dest_state_abr_cpd', [flights_dest], [53, 372]) in

let flights_unique_carrier_ = select flights_unique_carrier [18] in
let flightsProb0 = query [flights_distance, flights_year_date] [flights_unique_carrier_] [] [] in

let distance_m = loadTensor('distance_m', [3000]) in
let nrows = 1000000000 in
let flightsProb0Norm = normalize flightsProb0 [1] in
let exp_distance = expectation [flights_year_date] flightsProb0Norm distance_m [0] in

let flightsProb0_um = unitMat flightsProb0 in
let flightsProb0_count = expectation [flights_year_date] flightsProb0 flightsProb0_um [0, 1] in
let count_distance = nrows * flightsProb0_count in
let sum_distance = exp_distance * count_distance in

let flights_year_date_b2v = loadDictionary('flights_year_date_b2v', [22, 22]) in

let sum_distancerev = map sum_distance [flights_year_date_b2v] in
let sum_distancerev_lift = lift sum_distancerev in
sum_distancerev_lift