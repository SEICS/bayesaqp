let supplier_nrows = tensor(0, [], [10000.0])
let dwdate_nrows = tensor(0, [], [2556.0])
let part_nrows = contract(',->', part_nrows, lineorder_nrows)
let supplier_nrows = contract(',->', supplier_nrows, part_nrows)
let nrows = contract(',->', dwdate_nrows, supplier_nrows)
