let lo_orderkey = loadDiscrete('lo_orderkey', [], [750]) in
let lo_ordertotalprice = loadDiscrete('lo_ordertotalprice', [lo_orderkey], [1000, 750]) in
let lo_revenue = loadDiscrete('lo_revenue', [lo_ordertotalprice], [1000, 1000]) in
let lo_orderdate = loadDiscrete('lo_orderdate', [lo_ordertotalprice], [682, 1000]) in
let lo_custkey = loadDiscrete('lo_custkey', [lo_ordertotalprice], [749, 1000]) in
let lo_suppkey = loadDiscrete('lo_suppkey', [lo_ordertotalprice], [738, 1000]) in
let lo_extendedprice = loadDiscrete('lo_extendedprice', [lo_revenue], [1000, 1000]) in
let lo_discount = loadDiscrete('lo_discount', [lo_revenue], [10, 1000]) in
let lo_supplycost = loadDiscrete('lo_supplycost', [lo_extendedprice], [1000, 1000]) in
let lo_quantity = loadDiscrete('lo_quantity', [lo_extendedprice], [50, 1000]) in
let lo_partkey = loadDiscrete('lo_partkey', [lo_supplycost], [750, 1000]) in

let lo_ordertotalprice_m = loadTensor('lo_ordertotalprice_m', [1000]) in
let lineorderProb = query [lo_ordertotalprice] [] [] [] in

let lineorderPr_3Norm = normalize lineorderProb [] in
let exp_lo_ordertotalprice = expectation [] lineorderPr_3Norm lo_ordertotalprice_m  [0] in
exp_lo_ordertotalprice