let p_partkey = load('p_partkey', [], [150])
let p_name = load('p_name', [p_partkey], [150,150])
let p_brand1 = select(load('p_brand1', [p_name], [145,150]), [74], 0)
let res2 = contract('a,ba,cb->ac', p_partkey, p_name, p_brand1)
let partProb = res2
let lineorder_nrows = tensor(0, [], [26662.0])
let supplier_nrows = tensor(0, [], [10000.0])
let dwdate_nrows = tensor(0, [], [2556.0])
let part_nrows = tensor(0, [], [600000.0])
let supplier_nrows = contract(',->', supplier_nrows, lineorder_nrows)
let dwdate_nrows = contract(',->', dwdate_nrows, supplier_nrows)
let nrows = contract(',->', part_nrows, dwdate_nrows)
let s_suppkey = load('s_suppkey', [], [150])
let s_city = load('s_city', [s_suppkey], [131,150])
let s_nation = load('s_nation', [s_city], [25,131])
let s_region = select(load('s_region', [s_nation], [5,25]), [3], 0)
let res4 = contract('d,ed,fe,gf->d', s_suppkey, s_city, s_nation, s_region)
let supplierProb = res4
let d_datekey = load('d_datekey', [], [147])
let d_yearmonth = load('d_yearmonth', [d_datekey], [80,147])
let d_yearmonthnum = load('d_yearmonthnum', [d_yearmonth], [77,80])
let d_year = load('d_year', [d_yearmonthnum], [7,77])
let res6 = contract('h,ih,ji,kj->hk', d_datekey, d_yearmonth, d_yearmonthnum, d_year)
let dwdateProb = res6
let lo_orderkey = load('lo_orderkey', [], [150])
let lo_supplycost = load('lo_supplycost', [lo_orderkey], [200,150])
let lo_partkey = load('lo_partkey', [lo_supplycost], [150,200])
let lo_suppkey = load('lo_suppkey', [lo_supplycost], [150,200])
let lo_extendedprice = load('lo_extendedprice', [lo_supplycost], [200,200])
let lo_revenue = load('lo_revenue', [lo_extendedprice], [200,200])
let lo_ordertotalprice = load('lo_ordertotalprice', [lo_revenue], [200,200])
let lo_orderdate = load('lo_orderdate', [lo_ordertotalprice], [148,200])
let res8 = contract('l,ml,nm,om,pm,qp,rq,sr->nosq', lo_orderkey, lo_supplycost, lo_partkey, lo_suppkey, lo_extendedprice, lo_revenue, lo_ordertotalprice, lo_orderdate)
let lineorderProb = res8
let lo_revenue_m = load('lo_revenue_m', [], [200])
let lo_partkey_p_partkey = load('lo_partkey_p_partkey', [], [150,150])
let lo_suppkey_s_suppkey = load('lo_suppkey_s_suppkey', [], [150,150])
let lo_orderdate_d_datekey = load('lo_orderdate_d_datekey', [], [148,147])
let lineorderPr_0 = contract('nosq,ac->nosqac', lineorderProb, partProb)
let lineorderPr_1 = contract('nosqac,na->qosc', lineorderPr_0, lo_partkey_p_partkey)
let lineorderPr_1 = contract('qosc,d->qoscd', lineorderPr_1, supplierProb)
let lineorderPr_2 = contract('qoscd,od->qsc', lineorderPr_1, lo_suppkey_s_suppkey)
let lineorderPr_2 = contract('qsc,hk->qschk', lineorderPr_2, dwdateProb)
let lineorderPr_3 = contract('qschk,sh->qck', lineorderPr_2, lo_orderdate_d_datekey)

let dwdate_d_year = load('dwdate_d_year', [], [7,7])
let part_p_brand1 = load('part_p_brand1', [], [145, 1000])
let part_p_brand1 = select(part_p_brand1, [74], 0)
let lineorderPr_4 = contract('qck,cv,kt->qtv', lineorderPr_3, part_p_brand1, dwdate_d_year)

let lineorderPr_4Norm = normalize(lineorderPr_4, [1,2])
let exp_lo_revenue = contract('qtv,q->tv', lineorderPr_4Norm, lo_revenue_m)
exp_lo_revenue