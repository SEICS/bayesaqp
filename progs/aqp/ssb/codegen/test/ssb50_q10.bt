let c_region = loadDiscrete('c_region', [c_city], [5, 250]) in
let c_mktsegment = loadDiscrete('c_mktsegment', [c_address], [5, 1500]) in
let s_suppkey = loadDiscrete('s_suppkey', [], [1495]) in
let s_name = loadDiscrete('s_name', [s_suppkey], [1495, 1495]) in
let s_phone = loadDiscrete('s_phone', [s_suppkey], [1495, 1495]) in
let s_city = loadDiscrete('s_city', [s_phone], [250, 1495]) in
let s_address = loadDiscrete('s_address', [s_phone], [1495, 1495]) in
let s_nation = loadDiscrete('s_nation', [s_city], [25, 250]) in
let s_region = loadDiscrete('s_region', [s_city], [5, 250]) in
let d_datekey = loadDiscrete('d_datekey', [], [1186]) in
let d_date = loadDiscrete('d_date', [d_datekey], [1186, 1186]) in
let d_yearmonthnum = loadDiscrete('d_yearmonthnum', [d_datekey], [84, 1186]) in
let d_daynuminyear = loadDiscrete('d_daynuminyear', [d_date], [366, 1186]) in
let d_daynuminmonth = loadDiscrete('d_daynuminmonth', [d_date], [31, 1186]) in
let d_dayofweek = loadDiscrete('d_dayofweek', [d_date], [7, 1186]) in
let d_lastdayinmonthfl = loadDiscrete('d_lastdayinmonthfl', [d_date], [2, 1186]) in
let d_holidayfl = loadDiscrete('d_holidayfl', [d_date], [2, 1186]) in
let d_weeknuminyear = loadDiscrete('d_weeknuminyear', [d_daynuminyear], [53, 366]) in
let d_daynuminweek = loadDiscrete('d_daynuminweek', [d_dayofweek], [7, 7]) in
let d_weekdayfl = loadDiscrete('d_weekdayfl', [d_dayofweek], [2, 7]) in
let d_lastdayinweekfl = loadDiscrete('d_lastdayinweekfl', [d_dayofweek], [2, 7]) in
let d_yearmonth = loadDiscrete('d_yearmonth', [d_yearmonthnum], [84, 84]) in
let d_month = loadDiscrete('d_month', [d_yearmonthnum], [12, 84]) in
let d_year = loadDiscrete('d_year', [d_yearmonthnum], [7, 84]) in
let d_sellingseason = loadDiscrete('d_sellingseason', [d_yearmonthnum], [5, 84]) in
let d_monthnuminyear = loadDiscrete('d_monthnuminyear', [d_month], [12, 12]) in
let lo_orderkey = loadDiscrete('lo_orderkey', [], [1500]) in
let lo_ordertotalprice = loadDiscrete('lo_ordertotalprice', [lo_orderkey], [2000, 1500]) in
let lo_revenue = loadDiscrete('lo_revenue', [lo_ordertotalprice], [2000, 2000]) in
let lo_orderdate = loadDiscrete('lo_orderdate', [lo_ordertotalprice], [1414, 2000]) in
let lo_suppkey = loadDiscrete('lo_suppkey', [lo_ordertotalprice], [1495, 2000]) in
let lo_custkey = loadDiscrete('lo_custkey', [lo_ordertotalprice], [1499, 2000]) in
let lo_linenumber = loadDiscrete('lo_linenumber', [lo_ordertotalprice], [7, 2000]) in
let lo_shipmode = loadDiscrete('lo_shipmode', [lo_ordertotalprice], [7, 2000]) in
let lo_orderpriority = loadDiscrete('lo_orderpriority', [lo_ordertotalprice], [5, 2000]) in
let lo_extendedprice = loadDiscrete('lo_extendedprice', [lo_revenue], [2000, 2000]) in
let lo_discount = loadDiscrete('lo_discount', [lo_revenue], [10, 2000]) in
let lo_supplycost = loadDiscrete('lo_supplycost', [lo_extendedprice], [2000, 2000]) in
let lo_quantity = loadDiscrete('lo_quantity', [lo_extendedprice], [50, 2000]) in
let lo_partkey = loadDiscrete('lo_partkey', [lo_supplycost], [1499, 2000]) in
let lo_tax = loadDiscrete('lo_tax', [lo_supplycost], [9, 2000]) in

let p_mfgr_ = select p_mfgr [2, 4] in
let partProb0 = query [p_partkey] [p_mfgr_] [] [] in
let lineorder_nrows = 300005884 in
let dwdate_nrows = 2556 in
let customer_nrows = 1500000 in
let part_nrows = 1200000 in
let supplier_nrows = 100000 in
let dwdate_nrows = dwdate_nrows * lineorder_nrows in
let customer_nrows = customer_nrows * dwdate_nrows in
let part_nrows = part_nrows * customer_nrows in
let nrows = supplier_nrows * part_nrows in
let c_region_ = select c_region [4] in
let customerProb0 = query [c_custkey, c_nation] [c_region_] [] [] in
let s_region_ = select s_region [0] in
let supplierProb0 = query [s_suppkey] [s_region_] [] [] in
let dwdateProb0 = query [d_datekey, d_year] [] [] [] in
let lineorderProb0 = query [lo_suppkey, lo_partkey, lo_orderdate, lo_custkey, lo_revenue] [] [] [] in

let lo_revenue_m = loadTensor('lo_revenue_m', [2000]) in
let lineorderProb1 = query [lo_suppkey, lo_partkey, lo_orderdate, lo_custkey, lo_supplycost] [] [] [] in

let lo_supplycost_m = loadTensor('lo_supplycost_m', [2000]) in
let m3_lineorder_part = loadTensor('lo_partkey_p_partkey', [1499, 1500]) in
let m3_lineorder_customer = loadTensor('lo_custkey_c_custkey', [1499, 1500]) in
let m3_lineorder_supplier = loadTensor('lo_suppkey_s_suppkey', [1495, 1495]) in
let m3_lineorder_dwdate = loadTensor('lo_orderdate_d_datekey', [1414, 1186]) in
let lineorderProb0_0 = outer lineorderProb0 supplierProb0 in
let lineorderProb0_1 = expectation [lo_partkey, lo_orderdate, lo_custkey, lo_revenue] lineorderProb0_0 m3_lineorder_supplier [0, 5] in
let lineorderProb0_2 = outer lineorderProb0_1 partProb0 in
let lineorderProb0_3 = expectation [lo_orderdate, lo_custkey, lo_revenue] lineorderProb0_2 m3_lineorder_part [0, 4] in
let lineorderProb0_4 = outer lineorderProb0_3 dwdateProb0 in
let lineorderProb0_5 = expectation [lo_custkey, lo_revenue, d_year] lineorderProb0_4 m3_lineorder_dwdate [0, 3] in
let lineorderProb0_6 = outer lineorderProb0_5 customerProb0 in
let lineorderProb0_7 = expectation [lo_revenue, d_year, c_nation] lineorderProb0_6 m3_lineorder_customer [0, 3] in

let lineorderProb0_7Norm = normalize lineorderProb0_7 [1, 2] in
let exp_lo_revenue = expectation [lo_revenue,d_year,c_nation] lineorderProb0_7Norm lo_revenue_m [0] in

let lineorderProb0_7_exp_count = expectation [d_year, c_nation] lineorderProb0_7 exp_lo_revenue [0, 1, 2] in
let sum_lo_revenue = lineorderProb0_7_exp_count * nrows in

let m3_lineorder_part = loadTensor('lo_partkey_p_partkey', [1499, 1500]) in
let m3_lineorder_customer = loadTensor('lo_custkey_c_custkey', [1499, 1500]) in
let m3_lineorder_supplier = loadTensor('lo_suppkey_s_suppkey', [1495, 1495]) in
let m3_lineorder_dwdate = loadTensor('lo_orderdate_d_datekey', [1414, 1186]) in
let lineorderProb1_8 = outer lineorderProb1 supplierProb0 in
let lineorderProb1_9 = expectation [lo_partkey, lo_orderdate, lo_custkey, lo_supplycost] lineorderProb1_8 m3_lineorder_supplier [0, 5] in
let lineorderProb1_10 = outer lineorderProb1_9 partProb0 in
let lineorderProb1_11 = expectation [lo_orderdate, lo_custkey, lo_supplycost] lineorderProb1_10 m3_lineorder_part [0, 4] in
let lineorderProb1_12 = outer lineorderProb1_11 dwdateProb0 in
let lineorderProb1_13 = expectation [lo_custkey, lo_supplycost, d_year] lineorderProb1_12 m3_lineorder_dwdate [0, 3] in
let lineorderProb1_14 = outer lineorderProb1_13 customerProb0 in
let lineorderProb1_15 = expectation [lo_supplycost, d_year, c_nation] lineorderProb1_14 m3_lineorder_customer [0, 3] in

let lineorderProb1_15Norm = normalize lineorderProb1_15 [1, 2] in
let exp_lo_supplycost = expectation [lo_supplycost,d_year,c_nation] lineorderProb1_15Norm lo_supplycost_m [0] in

let lineorderProb1_15_exp_count = expectation [d_year, c_nation] lineorderProb1_15 exp_lo_supplycost [0, 1, 2] in
let sum_lo_supplycost = lineorderProb1_15_exp_count * nrows in

let res0 = sum_lo_revenue - sum_lo_supplycost in
let customer_c_nation = loadTensor('customer_c_nation', [25, 25]) in
let res0_decompress0 = decompress res0 customer_c_nation [c_nation] in
let customer_c_nation_b2v = loadDictionary('customer_c_nation_b2v', [25, 25]) in

let dwdate_d_year = loadTensor('dwdate_d_year', [7, 7]) in
let res0_decompress1 = decompress res0_decompress0 dwdate_d_year [d_year] in
let dwdate_d_year_b2v = loadDictionary('dwdate_d_year_b2v', [7, 7]) in

let res0_rev = map res0_decompress1 [dwdate_d_year_b2v, customer_c_nation_b2v] in
let res0_rev_lift = lift res0_rev in
res0_rev_lift