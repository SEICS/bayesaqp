let d_datekey = loadDiscrete('d_datekey', [], [1653]) in
let d_date = loadDiscrete('d_date', [d_datekey], [1653, 1653]) in
let d_yearmonthnum = loadDiscrete('d_yearmonthnum', [d_datekey], [84, 1653]) in
let d_daynuminyear = loadDiscrete('d_daynuminyear', [d_date], [366, 1653]) in
let d_daynuminmonth = loadDiscrete('d_daynuminmonth', [d_date], [31, 1653]) in
let d_dayofweek = loadDiscrete('d_dayofweek', [d_date], [7, 1653]) in
let d_lastdayinmonthfl = loadDiscrete('d_lastdayinmonthfl', [d_date], [2, 1653]) in
let d_holidayfl = loadDiscrete('d_holidayfl', [d_date], [2, 1653]) in
let d_weeknuminyear = loadDiscrete('d_weeknuminyear', [d_daynuminyear], [53, 366]) in
let d_daynuminweek = loadDiscrete('d_daynuminweek', [d_dayofweek], [7, 7]) in
let d_weekdayfl = loadDiscrete('d_weekdayfl', [d_dayofweek], [2, 7]) in
let d_lastdayinweekfl = loadDiscrete('d_lastdayinweekfl', [d_dayofweek], [2, 7]) in
let d_yearmonth = loadDiscrete('d_yearmonth', [d_yearmonthnum], [84, 84]) in
let d_month = loadDiscrete('d_month', [d_yearmonthnum], [12, 84]) in
let d_year = loadDiscrete('d_year', [d_yearmonthnum], [7, 84]) in
let d_sellingseason = loadDiscrete('d_sellingseason', [d_yearmonthnum], [5, 84]) in
let d_monthnuminyear = loadDiscrete('d_monthnuminyear', [d_month], [12, 12]) in
let lo_orderkey = loadDiscrete('lo_orderkey', [], [2250]) in
let lo_ordertotalprice = loadDiscrete('lo_ordertotalprice', [lo_orderkey], [3000, 2250]) in
let lo_custkey = loadDiscrete('lo_custkey', [lo_ordertotalprice], [2238, 3000]) in
let lo_orderdate = loadDiscrete('lo_orderdate', [lo_ordertotalprice], [1578, 3000]) in
let lo_revenue = loadDiscrete('lo_revenue', [lo_ordertotalprice], [3000, 3000]) in
let lo_extendedprice = loadDiscrete('lo_extendedprice', [lo_revenue], [3000, 3000]) in
let lo_suppkey = loadDiscrete('lo_suppkey', [lo_revenue], [2072, 3000]) in
let lo_discount = loadDiscrete('lo_discount', [lo_revenue], [10, 3000]) in
let lo_supplycost = loadDiscrete('lo_supplycost', [lo_extendedprice], [3000, 3000]) in
let lo_quantity = loadDiscrete('lo_quantity', [lo_extendedprice], [50, 3000]) in
let lo_partkey = loadDiscrete('lo_partkey', [lo_supplycost], [2248, 3000]) in
let p_partkey = loadDiscrete('p_partkey', [], [2249]) in
let p_name = loadDiscrete('p_name', [p_partkey], [2109, 2249]) in
let p_brand1 = loadDiscrete('p_brand1', [p_name], [924, 2109]) in
let p_type = loadDiscrete('p_type', [p_name], [150, 2109]) in
let p_color = loadDiscrete('p_color', [p_name], [92, 2109]) in
let p_size = loadDiscrete('p_size', [p_name], [50, 2109]) in
let p_container = loadDiscrete('p_container', [p_name], [40, 2109]) in
let p_category = loadDiscrete('p_category', [p_brand1], [25, 924]) in
let p_mfgr = loadDiscrete('p_mfgr', [p_category], [5, 25]) in

let d_weeknuminyear_ = select d_weeknuminyear [5] in
let d_year_ = select d_year [3] in
let dwdateProb = query [d_datekey,d_year] [d_weeknuminyear_,d_year_] [] [] in
let lineorder_nrows = 29999795 in
let dwdate_nrows = 2556 in
let part_nrows = 600000 in
let dwdate_nrows = dwdate_nrows * lineorder_nrows in
let nrows = part_nrows * dwdate_nrows in
let lo_discount_ = select lo_discount [4, 5, 6] in
let lo_quantity_ = select lo_quantity [3, 36, 38, 40, 15, 17, 19, 22, 26, 29] in
let lineorderProb = query [lo_partkey,lo_orderdate,lo_extendedprice,lo_discount] [lo_discount_,lo_quantity_] [] [] in

let lo_extendedprice_m = loadTensor('lo_extendedprice_m', [3000]) in
let lo_discount_m_ = loadTensor('lo_discount_m', [10]) in
let lo_discount_m = filter lo_discount_m_ [4, 5, 6] in
let partProb = query [p_partkey,p_brand1] [] [] [] in

let m3_lineorder_dwdate = loadTensor('lo_orderdate_d_datekey', [1578, 1653]) in
let m3_lineorder_part = loadTensor('lo_partkey_p_partkey', [2248, 2249]) in
let lineorderPr_0 = outer lineorderProb dwdateProb in
let lineorderPr_1 = expectation [lo_extendedprice,lo_discount,lo_partkey,d_year] lineorderPr_0 m3_lineorder_dwdate [1, 4] in
let lineorderPr_2 = outer lineorderPr_1 partProb in
let lineorderPr_3 = expectation [lo_extendedprice,lo_discount,d_year,p_brand1] lineorderPr_2 m3_lineorder_part [2, 4] in

let lineorderPr_3Norm = normalize lineorderPr_3 [2,3] in
let lo_extendedprice_lo_discount_m = outer lo_extendedprice_m lo_discount_m in
let exp_lo_revenue = expectation [lo_extendedprice,lo_discount,d_year,p_brand1] lineorderPr_3Norm lo_extendedprice_lo_discount_m  [0,1] in

let count_exp_lo_revenue = expectation [d_year,p_brand1] exp_lo_revenue lineorderPr_3  [0,1,2,3] in
let sum_lo_revenue = nrows * count_exp_lo_revenue in

let dwdate_d_year = loadTensor('dwdate_d_year', [7,7]) in
let part_p_brand1 = loadTensor('part_p_brand1', [924, 1000]) in
let sum_lo_revenue_2 = decompress sum_lo_revenue part_p_brand1 [p_brand1] in
let sum_lo_revenue_3 = decompress sum_lo_revenue_2 dwdate_d_year [d_year] in

let dwdate_d_year_b2v = loadDictionary('dwdate_d_year_b2v', [7,7]) in
let part_p_brand1_b2v = loadDictionary('part_p_brand1_b2v', [924, 1000]) in
let sum_lo_revenue_rev = map sum_lo_revenue_3 [dwdate_d_year_b2v, part_p_brand1_b2v] in
let sum_lo_revenue_rev_lift = lift sum_lo_revenue_rev in
sum_lo_revenue_rev_lift