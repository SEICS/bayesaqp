let lineorder = query [lo_orderdate,lo_revenue] [] [] [] in
let dwdate = query [d_datekey,d_year] [] [] [] in
let prep1 = outer lineorder dwdate in
let join1 = expectation [lo_revenue,d_year] prep1 idx_mat [0, 2] in
let norm = normalize join1 [1] in
let avg = expectation [d_year] norm lo_revenue_w [0] in
let ones = unitMat join1 in
let countProb = expectation [d_year] join1 ones in
let count = countProb * nrows in 
sum = avg * count