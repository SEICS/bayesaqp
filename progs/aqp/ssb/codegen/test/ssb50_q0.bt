let dwdate_d_datekey = loadDiscrete('dwdate_d_datekey_cpd', [], [1186]) in
let dwdate_d_date = loadDiscrete('dwdate_d_date_cpd', [dwdate_d_datekey], [1186, 1186]) in
let dwdate_d_yearmonthnum = loadDiscrete('dwdate_d_yearmonthnum_cpd', [dwdate_d_datekey], [84, 1186]) in
let dwdate_d_daynuminyear = loadDiscrete('dwdate_d_daynuminyear_cpd', [dwdate_d_date], [366, 1186]) in
let dwdate_d_daynuminmonth = loadDiscrete('dwdate_d_daynuminmonth_cpd', [dwdate_d_date], [31, 1186]) in
let dwdate_d_dayofweek = loadDiscrete('dwdate_d_dayofweek_cpd', [dwdate_d_date], [7, 1186]) in
let dwdate_d_lastdayinmonthfl = loadDiscrete('dwdate_d_lastdayinmonthfl_cpd', [dwdate_d_date], [2, 1186]) in
let dwdate_d_holidayfl = loadDiscrete('dwdate_d_holidayfl_cpd', [dwdate_d_date], [2, 1186]) in
let dwdate_d_weeknuminyear = loadDiscrete('dwdate_d_weeknuminyear_cpd', [dwdate_d_daynuminyear], [53, 366]) in
let dwdate_d_daynuminweek = loadDiscrete('dwdate_d_daynuminweek_cpd', [dwdate_d_dayofweek], [7, 7]) in
let dwdate_d_weekdayfl = loadDiscrete('dwdate_d_weekdayfl_cpd', [dwdate_d_dayofweek], [2, 7]) in
let dwdate_d_lastdayinweekfl = loadDiscrete('dwdate_d_lastdayinweekfl_cpd', [dwdate_d_dayofweek], [2, 7]) in
let dwdate_d_yearmonth = loadDiscrete('dwdate_d_yearmonth_cpd', [dwdate_d_yearmonthnum], [84, 84]) in
let dwdate_d_month = loadDiscrete('dwdate_d_month_cpd', [dwdate_d_yearmonthnum], [12, 84]) in
let dwdate_d_year = loadDiscrete('dwdate_d_year_cpd', [dwdate_d_yearmonthnum], [7, 84]) in
let dwdate_d_sellingseason = loadDiscrete('dwdate_d_sellingseason_cpd', [dwdate_d_yearmonthnum], [5, 84]) in
let dwdate_d_monthnuminyear = loadDiscrete('dwdate_d_monthnuminyear_cpd', [dwdate_d_month], [12, 12]) in
let lineorder_lo_orderkey = loadDiscrete('lineorder_lo_orderkey_cpd', [], [1500]) in
let lineorder_lo_ordertotalprice = loadDiscrete('lineorder_lo_ordertotalprice_cpd', [lineorder_lo_orderkey], [2000, 1500]) in
let lineorder_lo_revenue = loadDiscrete('lineorder_lo_revenue_cpd', [lineorder_lo_ordertotalprice], [2000, 2000]) in
let lineorder_lo_orderdate = loadDiscrete('lineorder_lo_orderdate_cpd', [lineorder_lo_ordertotalprice], [1414, 2000]) in
let lineorder_lo_suppkey = loadDiscrete('lineorder_lo_suppkey_cpd', [lineorder_lo_ordertotalprice], [1495, 2000]) in
let lineorder_lo_custkey = loadDiscrete('lineorder_lo_custkey_cpd', [lineorder_lo_ordertotalprice], [1499, 2000]) in
let lineorder_lo_linenumber = loadDiscrete('lineorder_lo_linenumber_cpd', [lineorder_lo_ordertotalprice], [7, 2000]) in
let lineorder_lo_shipmode = loadDiscrete('lineorder_lo_shipmode_cpd', [lineorder_lo_ordertotalprice], [7, 2000]) in
let lineorder_lo_orderpriority = loadDiscrete('lineorder_lo_orderpriority_cpd', [lineorder_lo_ordertotalprice], [5, 2000]) in
let lineorder_lo_extendedprice = loadDiscrete('lineorder_lo_extendedprice_cpd', [lineorder_lo_revenue], [2000, 2000]) in
let lineorder_lo_discount = loadDiscrete('lineorder_lo_discount_cpd', [lineorder_lo_revenue], [10, 2000]) in
let lineorder_lo_supplycost = loadDiscrete('lineorder_lo_supplycost_cpd', [lineorder_lo_extendedprice], [2000, 2000]) in
let lineorder_lo_quantity = loadDiscrete('lineorder_lo_quantity_cpd', [lineorder_lo_extendedprice], [50, 2000]) in
let lineorder_lo_partkey = loadDiscrete('lineorder_lo_partkey_cpd', [lineorder_lo_supplycost], [1499, 2000]) in
let lineorder_lo_tax = loadDiscrete('lineorder_lo_tax_cpd', [lineorder_lo_supplycost], [9, 2000]) in

let dwdate_d_year_ = select dwdate_d_year [2] in
let dwdateProb0 = query [dwdate_d_datekey] [dwdate_d_year_] [] [] in
let lineorder_nrows = 300005884 in
let dwdate_nrows = 2556 in
let nrows = dwdate_nrows * lineorder_nrows in
let lineorder_lo_discount_ = select lineorder_lo_discount [0, 1, 2] in
let lineorder_lo_quantity_ = select lineorder_lo_quantity [0, 2, 5, 6, 7, 10, 11, 12, 17, 18, 19, 20, 21, 28, 30, 32, 39, 41, 42, 44, 45, 46, 47, 49] in
let lineorderProb0 = query [lineorder_lo_orderdate, lineorder_lo_extendedprice, lineorder_lo_discount] [lineorder_lo_discount_, lineorder_lo_quantity_] [] [] in

let lineorder_lo_extendedprice_m = loadTensor('lineorder_lo_extendedprice_m', [2000]) in
let lineorder_lo_discount_m_ = loadTensor('lineorder_lo_discount_m', [10]) in
let lineorder_lo_discount_m = filter lineorder_lo_discount_m_ [0, 1, 2] in
let m3_lineorder_dwdate = loadTensor('lineorder_lo_orderdate_dwdate_d_datekey_pkfk', [1414, 1186]) in
let lineorderProb0_0 = outer lineorderProb0 dwdateProb0 in
let lineorderProb0_1 = expectation [lineorder_lo_extendedprice, lineorder_lo_discount] lineorderProb0_0 m3_lineorder_dwdate [0, 3] in

let lineorderProb0_1Norm = normalize lineorderProb0_1 [] in
let ms0 = outer lineorder_lo_extendedprice_m lineorder_lo_discount_m in
let exp_lo_extendedprice_lo_discount = expectation [] lineorderProb0_1Norm ms0 [0, 1] in

let lineorderProb0_1_um = unitMat lineorderProb0_1 in
let lineorderProb0_1_count = expectation [] lineorderProb0_1 lineorderProb0_1_um [0, 1] in
let count_lo_extendedprice_lo_discount = nrows * lineorderProb0_1_count in
let sum_lo_extendedprice_lo_discount = exp_lo_extendedprice_lo_discount * count_lo_extendedprice_lo_discount in

sum_lo_extendedprice_lo_discount