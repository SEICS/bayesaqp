let c_custkey = loadDiscrete('c_custkey', [], [1124]) in
let c_name = loadDiscrete('c_name', [c_custkey], [1124, 1124]) in
let c_phone = loadDiscrete('c_phone', [c_custkey], [1124, 1124]) in
let c_city = loadDiscrete('c_city', [c_phone], [250, 1124]) in
let c_address = loadDiscrete('c_address', [c_phone], [1124, 1124]) in
let c_nation = loadDiscrete('c_nation', [c_city], [25, 250]) in
let c_region = loadDiscrete('c_region', [c_nation], [5, 25]) in
let c_mktsegment = loadDiscrete('c_mktsegment', [c_address], [5, 1124]) in
let s_suppkey = loadDiscrete('s_suppkey', [], [1116]) in
let s_name = loadDiscrete('s_name', [s_suppkey], [1116, 1116]) in
let s_phone = loadDiscrete('s_phone', [s_suppkey], [1116, 1116]) in
let s_address = loadDiscrete('s_address', [s_phone], [1116, 1116]) in
let s_city = loadDiscrete('s_city', [s_phone], [250, 1116]) in
let s_nation = loadDiscrete('s_nation', [s_city], [25, 250]) in
let s_region = loadDiscrete('s_region', [s_city], [5, 250]) in
let d_datekey = loadDiscrete('d_datekey', [], [1102]) in
let d_date = loadDiscrete('d_date', [d_datekey], [1102, 1102]) in
let d_yearmonthnum = loadDiscrete('d_yearmonthnum', [d_datekey], [84, 1102]) in
let d_daynuminyear = loadDiscrete('d_daynuminyear', [d_date], [366, 1102]) in
let d_daynuminmonth = loadDiscrete('d_daynuminmonth', [d_date], [31, 1102]) in
let d_dayofweek = loadDiscrete('d_dayofweek', [d_date], [7, 1102]) in
let d_lastdayinmonthfl = loadDiscrete('d_lastdayinmonthfl', [d_date], [2, 1102]) in
let d_holidayfl = loadDiscrete('d_holidayfl', [d_date], [2, 1102]) in
let d_weeknuminyear = loadDiscrete('d_weeknuminyear', [d_daynuminyear], [53, 366]) in
let d_daynuminweek = loadDiscrete('d_daynuminweek', [d_dayofweek], [7, 7]) in
let d_weekdayfl = loadDiscrete('d_weekdayfl', [d_dayofweek], [2, 7]) in
let d_lastdayinweekfl = loadDiscrete('d_lastdayinweekfl', [d_dayofweek], [2, 7]) in
let d_yearmonth = loadDiscrete('d_yearmonth', [d_yearmonthnum], [84, 84]) in
let d_month = loadDiscrete('d_month', [d_yearmonthnum], [12, 84]) in
let d_year = loadDiscrete('d_year', [d_yearmonthnum], [7, 84]) in
let d_sellingseason = loadDiscrete('d_sellingseason', [d_yearmonthnum], [5, 84]) in
let d_monthnuminyear = loadDiscrete('d_monthnuminyear', [d_month], [12, 12]) in
let p_partkey = loadDiscrete('p_partkey', [], [1125]) in
let p_name = loadDiscrete('p_name', [p_partkey], [1089, 1125]) in
let p_brand1 = loadDiscrete('p_brand1', [p_name], [816, 1089]) in
let p_type = loadDiscrete('p_type', [p_name], [150, 1089]) in
let p_color = loadDiscrete('p_color', [p_name], [92, 1089]) in
let p_size = loadDiscrete('p_size', [p_name], [50, 1089]) in
let p_container = loadDiscrete('p_container', [p_name], [40, 1089]) in
let p_category = loadDiscrete('p_category', [p_brand1], [25, 816]) in
let p_mfgr = loadDiscrete('p_mfgr', [p_category], [5, 25]) in
let lo_orderkey = loadDiscrete('lo_orderkey', [], [1125]) in
let lo_ordertotalprice = loadDiscrete('lo_ordertotalprice', [lo_orderkey], [1500, 1125]) in
let lo_revenue = loadDiscrete('lo_revenue', [lo_ordertotalprice], [1500, 1500]) in
let lo_orderdate = loadDiscrete('lo_orderdate', [lo_ordertotalprice], [1052, 1500]) in
let lo_custkey = loadDiscrete('lo_custkey', [lo_ordertotalprice], [1122, 1500]) in
let lo_suppkey = loadDiscrete('lo_suppkey', [lo_ordertotalprice], [1116, 1500]) in
let lo_extendedprice = loadDiscrete('lo_extendedprice', [lo_revenue], [1500, 1500]) in
let lo_discount = loadDiscrete('lo_discount', [lo_revenue], [10, 1500]) in
let lo_supplycost = loadDiscrete('lo_supplycost', [lo_extendedprice], [1500, 1500]) in
let lo_quantity = loadDiscrete('lo_quantity', [lo_extendedprice], [50, 1500]) in
let lo_partkey = loadDiscrete('lo_partkey', [lo_supplycost], [1125, 1500]) in

let c_region_ = select c_region [2] in
let customerProb = query [c_custkey] [c_region_] [] [] in
let lineorder_nrows = 29999795 in
let dwdate_nrows = 2556 in
let customer_nrows = 150000 in
let supplier_nrows = 10000 in
let part_nrows = 600000 in
let dwdate_nrows = dwdate_nrows * lineorder_nrows in
let customer_nrows = customer_nrows * dwdate_nrows in
let supplier_nrows = supplier_nrows * customer_nrows in
let nrows = part_nrows * supplier_nrows in
let s_nation_ = select s_nation [17] in
let supplierProb = query [s_suppkey,s_city] [s_nation_] [] [] in
let d_year_ = select d_year [5, 6] in
let dwdateProb = query [d_datekey,d_year] [d_year_] [] [] in
let p_category_ = select p_category [15] in
let partProb = query [p_partkey,p_brand1] [p_category_] [] [] in
let lineorderProb = query [lo_suppkey,lo_partkey,lo_custkey,lo_orderdate,lo_revenue] [] [] [] in

let lo_revenue_m = loadTensor('lo_revenue_m', [1500]) in
let lo_supplycost_m = loadTensor('lo_supplycost_m', [1500]) in

let lo_revenue_m = loadTensor('lo_revenue_m', [1500]) in
let m3_lineorder_customer = loadTensor('lo_custkey_c_custkey', [1122, 1124]) in
let m3_lineorder_supplier = loadTensor('lo_suppkey_s_suppkey', [1116, 1116]) in
let m3_lineorder_dwdate = loadTensor('lo_orderdate_d_datekey', [1052, 1102]) in
let m3_lineorder_part = loadTensor('lo_partkey_p_partkey', [1125, 1125]) in
let lineorderPr_0 = outer lineorderProb customerProb in
let lineorderPr_1 = expectation [lo_revenue,lo_suppkey,lo_partkey,lo_orderdate] lineorderPr_0 m3_lineorder_customer [2, 5] in
let lineorderPr_1 = outer lineorderPr_1 supplierProb in
let lineorderPr_2 = expectation [lo_revenue,lo_partkey,lo_orderdate,s_city] lineorderPr_1 m3_lineorder_supplier [1, 4] in
let lineorderPr_2 = outer lineorderPr_2 dwdateProb in
let lineorderPr_3 = expectation [lo_revenue,lo_partkey,d_year,s_city] lineorderPr_2 m3_lineorder_dwdate [2, 4] in
let lineorderPr_3 = outer lineorderPr_3 partProb in
let lineorderPr_4 = expectation [lo_revenue,d_year,s_city,p_brand1] lineorderPr_3 m3_lineorder_part [1, 4] in

let lineorderPr_4Norm = normalize lineorderPr_4 [1,2,3] in
let exp_lo_revenue = expectation [lo_revenue,d_year,s_city,p_brand1] lineorderPr_4Norm lo_revenue_m [0] in

let count_exp_lo_revenue = expectation [d_year,s_city,p_brand1] exp_lo_revenue lineorderPr_4  [0,1,2,3] in
let sum_lo_revenue = nrows * count_exp_lo_revenue in

let lineorderProb2 = query [lo_suppkey,lo_partkey,lo_custkey,lo_orderdate,lo_supplycost] [] [] [] in

let lo_supplycost_m = loadTensor('lo_supplycost_m', [1500]) in
let lineorderPr2_0 = outer lineorderProb2 customerProb in
let lineorderPr2_1 = expectation [lo_supplycost,lo_suppkey,lo_partkey,lo_orderdate] lineorderPr2_0 m3_lineorder_customer [2, 5] in
let lineorderPr2_1 = outer lineorderPr2_1 supplierProb in
let lineorderPr2_2 = expectation [lo_supplycost,lo_partkey,lo_orderdate,s_city] lineorderPr2_1 m3_lineorder_supplier [1, 4] in
let lineorderPr2_2 = outer lineorderPr2_2 dwdateProb in
let lineorderPr2_3 = expectation [lo_supplycost,lo_partkey,d_year,s_city] lineorderPr2_2 m3_lineorder_dwdate [2, 4] in
let lineorderPr2_3 = outer lineorderPr2_3 partProb in
let lineorderPr2_4 = expectation [lo_supplycost,d_year,s_city,p_brand1] lineorderPr2_3 m3_lineorder_part [1, 4] in

let lineorderPr2_4Norm = normalize lineorderPr2_4 [1,2,3] in
let exp_lo_supplycost = expectation [lo_supplycost,d_year,s_city,p_brand1] lineorderPr2_4Norm lo_supplycost_m [0] in

let count_exp_lo_supplycost = expectation [d_year,s_city,p_brand1] exp_lo_supplycost lineorderPr2_4  [0,1,2,3] in
let sum_lo_supplycost = nrows * count_exp_lo_supplycost in

let qres = sum_lo_revenue - sum_lo_supplycost in

let part_p_brand1 = loadTensor('part_p_brand1', [816,1000]) in 
let supplier_s_city = loadTensor('supplier_s_city', [250,250]) in
let dwdate_d_year = loadTensor('dwdate_d_year', [7,7]) in
let dwdate_d_year = filter dwdate_d_year [5, 6] in

let qres_2 = decompress qres part_p_brand1 [p_brand1] in
let qres_3 = decompress qres_2 supplier_s_city [s_city] in
let qres_4 = decompress qres_3 dwdate_d_year [d_year] in

let dwdate_d_year_b2v = loadDictionary('dwdate_d_year_b2v', [7,7]) in
let supplier_s_city_b2v = loadDictionary('supplier_s_city_b2v', [250,250]) in 
let part_p_brand1_b2v = loadDictionary('part_p_brand1_b2v', [816,1000]) in

let qres_rev = map qres_4 [dwdate_d_year_b2v, supplier_s_city_b2v, part_p_brand1_b2v] in
let qres_rev_lift = lift qres_rev in

qres_rev_lift