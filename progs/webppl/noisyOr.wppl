// http://webppl.org/
var prog = function() {
  var n0 = flip(0.5);
  var n4 = flip(0.5);
  var n1 = n0 ? flip(0.8) : flip(0.1);
  var n21 = n0 ? flip(0.8) : flip(0.1);
  var n22 = n4 ? flip(0.8) : flip(0.1);
  var n33 = n4 ? flip(0.8) : flip(0.1);
  var n2 = n21 || n22;
  var n31 = n1 ? flip(0.8) : flip(0.1);
  var n32 = n2 ? flip(0.8) : flip(0.1);
  var n3t = n32 || n33;
  var n3 = n31 || n3t;
  return n3;
}

var dist = Infer(
  {method: 'enumerate', maxExecutions: 1000000},
  prog);

print(dist);
// {"probs":[0.18558125000000014,0.81441875],"support":[false,true]}
