let p_partkey = load('p_partkey', [], [150])
let p_name = load('p_name', [p_partkey], [150,150])
let p_brand1 = load('p_brand1', [p_name], [145,150])
let p_category = select(load('p_category', [p_brand1], [25,145]), [16], 0)
let res2 = contract('a,ba,cb,dc->a', p_partkey, p_name, p_brand1, p_category)
let partProb = res2
let lineorder_nrows = tensor(0, [], [26662.0])
let supplier_nrows = tensor(0, [], [10000.0])
let part_nrows = tensor(0, [], [600000.0])
let supplier_nrows = contract(',->', supplier_nrows, lineorder_nrows)
let nrows = contract(',->', part_nrows, supplier_nrows)
let s_suppkey = load('s_suppkey', [], [150])
let s_city = load('s_city', [s_suppkey], [131,150])
let s_nation = load('s_nation', [s_city], [25,131])
let s_region = select(load('s_region', [s_nation], [5,25]), [0], 0)
let res4 = contract('b,cb,dc,ed->b', s_suppkey, s_city, s_nation, s_region)
let supplierProb = res4
let lo_orderkey = load('lo_orderkey', [], [150])
let lo_supplycost = load('lo_supplycost', [lo_orderkey], [200,150])
let lo_partkey = load('lo_partkey', [lo_supplycost], [150,200])
let lo_suppkey = load('lo_suppkey', [lo_supplycost], [150,200])
let lo_extendedprice = load('lo_extendedprice', [lo_supplycost], [200,200])
let lo_revenue = load('lo_revenue', [lo_extendedprice], [200,200])
let res6 = contract('c,dc,ed,fd,gd,hg->efh', lo_orderkey, lo_supplycost, lo_partkey, lo_suppkey, lo_extendedprice, lo_revenue)
let lineorderProb = res6
let lo_revenue_m = load('lo_revenue_m', [], [200])
let lo_partkey_p_partkey = load('lo_partkey_p_partkey', [], [150,150])
let lo_suppkey_s_suppkey = load('lo_suppkey_s_suppkey', [], [150,150])
let lineorderPr_0 = contract('efh,a->efha', lineorderProb, partProb)
let lineorderPr_0 = contract('efha,ea->hf', lineorderPr_0, lo_partkey_p_partkey)
let lineorderPr_1 = contract('hf,b->hfb', lineorderPr_0, supplierProb)
let lineorderPr_1 = contract('hfb,fb->h', lineorderPr_1, lo_suppkey_s_suppkey)
let lineorderPr_1Norm = normalize(lineorderPr_1, [])
let exp1 = contract('h,h->', lineorderPr_1Norm, lo_revenue_m)
exp1
