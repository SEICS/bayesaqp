let p_partkey = loadDiscrete('p_partkey', [], [1500]) in
let p_name = loadDiscrete('p_name', [p_partkey], [1437, 1500]) in
let p_brand1 = loadDiscrete('p_brand1', [p_name], [841, 1437]) in
let p_type = loadDiscrete('p_type', [p_name], [150, 1437]) in
let p_color = loadDiscrete('p_color', [p_name], [92, 1437]) in
let p_size = loadDiscrete('p_size', [p_name], [50, 1437]) in
let p_container = loadDiscrete('p_container', [p_name], [40, 1437]) in
let p_category = loadDiscrete('p_category', [p_brand1], [25, 841]) in
let p_mfgr = loadDiscrete('p_mfgr', [p_category], [5, 25]) in
let c_custkey = loadDiscrete('c_custkey', [], [1500]) in
let c_name = loadDiscrete('c_name', [c_custkey], [1500, 1500]) in
let c_phone = loadDiscrete('c_phone', [c_custkey], [1500, 1500]) in
let c_city = loadDiscrete('c_city', [c_phone], [250, 1500]) in
