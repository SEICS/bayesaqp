let res8 = contract('i,ji,kj,lj,ml,nm,on,pj,a,ka,d,pd->mo', lo_orderkey, lo_supplycost, lo_partkey, lo_extendedprice, lo_revenue, lo_ordertotalprice, lo_orderdate, lo_suppkey, partProb, lo_partkey_p_partkey, supplierProb, lo_suppkey_s_suppkey)
