let lineorder_lo_tax = loadDiscrete('lineorder_lo_tax_cpd', [lineorder_lo_supplycost], [9, 2000]) in

let part_p_mfgr_ = select part_p_mfgr [2, 4] in
let partProb0 = query [part_p_partkey, part_p_category] [part_p_mfgr_] [] [] in
let lineorder_nrows = 300005884 in
let part_nrows = 1200000 in
let customer_nrows = 1500000 in
let dwdate_nrows = 2556 in
let supplier_nrows = 100000 in
let part_nrows = part_nrows * lineorder_nrows in
let customer_nrows = customer_nrows * part_nrows in
let dwdate_nrows = dwdate_nrows * customer_nrows in
let nrows = supplier_nrows * dwdate_nrows in
let customer_c_region_ = select customer_c_region [4] in
let customerProb0 = query [customer_c_custkey] [customer_c_region_] [] [] in
let supplier_s_region_ = select supplier_s_region [0] in
let supplierProb0 = query [supplier_s_suppkey, supplier_s_nation] [supplier_s_region_] [] [] in
let dwdate_d_year_ = select dwdate_d_year [5, 6] in
let dwdateProb0 = query [dwdate_d_datekey, dwdate_d_year] [dwdate_d_year_] [] [] in
let lineorderProb0 = query [lineorder_lo_custkey, lineorder_lo_partkey, lineorder_lo_orderdate, lineorder_lo_suppkey, lineorder_lo_revenue] [] [] [] in

let lineorder_lo_revenue_m = loadTensor('lineorder_lo_revenue_m', [2000]) in
let lineorderProb1 = query [lineorder_lo_custkey, lineorder_lo_partkey, lineorder_lo_orderdate, lineorder_lo_suppkey, lineorder_lo_supplycost] [] [] [] in

let lineorder_lo_supplycost_m = loadTensor('lineorder_lo_supplycost_m', [2000]) in
let m3_lineorder_part = loadTensor('lineorder_lo_partkey_part_p_partkey_pkfk', [1499, 1500]) in
let m3_lineorder_customer = loadTensor('lineorder_lo_custkey_customer_c_custkey_pkfk', [1499, 1500]) in
let m3_lineorder_supplier = loadTensor('lineorder_lo_suppkey_supplier_s_suppkey_pkfk', [1495, 1495]) in
let m3_lineorder_dwdate = loadTensor('lineorder_lo_orderdate_dwdate_d_datekey_pkfk', [1414, 1186]) in
let lineorderProb0_0 = outer lineorderProb0 customerProb0 in
let lineorderProb0_1 = expectation [lineorder_lo_partkey, lineorder_lo_orderdate, lineorder_lo_suppkey, lineorder_lo_revenue] lineorderProb0_0 m3_lineorder_customer [0, 5] in
let lineorderProb0_2 = outer lineorderProb0_1 dwdateProb0 in
let lineorderProb0_3 = expectation [lineorder_lo_partkey, lineorder_lo_suppkey, lineorder_lo_revenue, dwdate_d_year] lineorderProb0_2 m3_lineorder_dwdate [1, 4] in
let lineorderProb0_4 = outer lineorderProb0_3 supplierProb0 in
let lineorderProb0_5 = expectation [lineorder_lo_partkey, lineorder_lo_revenue, dwdate_d_year, supplier_s_nation] lineorderProb0_4 m3_lineorder_supplier [1, 4] in
let lineorderProb0_6 = outer lineorderProb0_5 partProb0 in
let lineorderProb0_7 = expectation [lineorder_lo_revenue, dwdate_d_year, supplier_s_nation, part_p_category] lineorderProb0_6 m3_lineorder_part [0, 4] in

let lineorderProb0_7Norm = normalize lineorderProb0_7 [1, 2, 3] in
let exp_lo_revenue = expectation [lineorder_lo_revenue,dwdate_d_year,supplier_s_nation,part_p_category] lineorderProb0_7Norm lineorder_lo_revenue_m [0] in

let lineorderProb0_7_exp_count = expectation [dwdate_d_year, supplier_s_nation, part_p_category] lineorderProb0_7 exp_lo_revenue [0, 1, 2, 3] in
let sum_lo_revenue = lineorderProb0_7_exp_count * nrows in

let m3_lineorder_part = loadTensor('lineorder_lo_partkey_part_p_partkey_pkfk', [1499, 1500]) in
let m3_lineorder_customer = loadTensor('lineorder_lo_custkey_customer_c_custkey_pkfk', [1499, 1500]) in
let m3_lineorder_supplier = loadTensor('lineorder_lo_suppkey_supplier_s_suppkey_pkfk', [1495, 1495]) in
let m3_lineorder_dwdate = loadTensor('lineorder_lo_orderdate_dwdate_d_datekey_pkfk', [1414, 1186]) in
let lineorderProb1_8 = outer lineorderProb1 customerProb0 in
let lineorderProb1_9 = expectation [lineorder_lo_partkey, lineorder_lo_orderdate, lineorder_lo_suppkey, lineorder_lo_supplycost] lineorderProb1_8 m3_lineorder_customer [0, 5] in
let lineorderProb1_10 = outer lineorderProb1_9 dwdateProb0 in
let lineorderProb1_11 = expectation [lineorder_lo_partkey, lineorder_lo_suppkey, lineorder_lo_supplycost, dwdate_d_year] lineorderProb1_10 m3_lineorder_dwdate [1, 4] in
let lineorderProb1_12 = outer lineorderProb1_11 supplierProb0 in
let lineorderProb1_13 = expectation [lineorder_lo_partkey, lineorder_lo_supplycost, dwdate_d_year, supplier_s_nation] lineorderProb1_12 m3_lineorder_supplier [1, 4] in
let lineorderProb1_14 = outer lineorderProb1_13 partProb0 in
let lineorderProb1_15 = expectation [lineorder_lo_supplycost, dwdate_d_year, supplier_s_nation, part_p_category] lineorderProb1_14 m3_lineorder_part [0, 4] in

let lineorderProb1_15Norm = normalize lineorderProb1_15 [1, 2, 3] in
let exp_lo_supplycost = expectation [lineorder_lo_supplycost,dwdate_d_year,supplier_s_nation,part_p_category] lineorderProb1_15Norm lineorder_lo_supplycost_m [0] in

let lineorderProb1_15_exp_count = expectation [dwdate_d_year, supplier_s_nation, part_p_category] lineorderProb1_15 exp_lo_supplycost [0, 1, 2, 3] in
let sum_lo_supplycost = lineorderProb1_15_exp_count * nrows in

let res0 = sum_lo_revenue - sum_lo_supplycost in
let part_p_category = loadTensor('part_p_category_idxmat', [25, 25]) in
let res0_decompress0 = decompress res0 part_p_category [p_category] in
let part_p_category_b2v = loadDictionary('part_p_category_b2v', [25, 25]) in

let supplier_s_nation = loadTensor('supplier_s_nation_idxmat', [25, 25]) in
let res0_decompress1 = decompress res0_decompress0 supplier_s_nation [s_nation] in
let supplier_s_nation_b2v = loadDictionary('supplier_s_nation_b2v', [25, 25]) in

let dwdate_d_year = loadTensor('dwdate_d_year_idxmat', [7, 7]) in
let dwdate_d_year = filter dwdate_d_year [5, 6] in
let res0_decompress2 = decompress res0_decompress1 dwdate_d_year [d_year] in
let dwdate_d_year_b2v = loadDictionary('dwdate_d_year_b2v', [7, 7]) in

let res0_rev = map res0_decompress2 [dwdate_d_year_b2v, supplier_s_nation_b2v, part_p_category_b2v] in
let res0_rev_lift = lift res0_rev in
res0_rev_lift