// http://webppl.org/
var prog = function() {
  var cloudy = flip(0.5);
  var rain = cloudy ? flip(0.8) : flip(0.2);
  var sprinkler = cloudy ? flip(0.1) : flip(0.5);
  var temp1 = flip(0.7);
  var wetRoof = temp1 && rain;
  var temp2 = flip(0.9);
  var temp3 = flip(0.9);
  var temp4 = temp2 && rain;
  var temp5 = temp3 && sprinkler;
  var wetGrass = temp4 || temp5;
  condition(wetGrass);
  return rain;
}

var dist = Infer(
  {method: 'enumerate', maxExecutions: 1000000},
  prog);

print(dist);
// {"probs":[0.7079276773296246,0.29207232267037553],"support":[true,false]}
