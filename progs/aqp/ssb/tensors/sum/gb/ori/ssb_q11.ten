let c_custkey = load('c_custkey', [], [150])
let c_city = load('c_city', [c_custkey], [131,150])
let c_nation = load('c_nation', [c_city], [25,131])
let c_region = select(load('c_region', [c_nation], [5,25]), [2], 0)
let res2 = contract('a,ba,cb,dc->a', c_custkey, c_city, c_nation, c_region)
let customerProb = res2
let lineorder_nrows = tensor(0, [], [26662.0])
let supplier_nrows = tensor(0, [], [10000.0])
let customer_nrows = tensor(0, [], [150000.0])
let dwdate_nrows = tensor(0, [], [2556.0])
let part_nrows = tensor(0, [], [600000.0])
let supplier_nrows = contract(',->', supplier_nrows, lineorder_nrows)
let customer_nrows = contract(',->', customer_nrows, supplier_nrows)
let dwdate_nrows = contract(',->', dwdate_nrows, customer_nrows)
let nrows = contract(',->', part_nrows, dwdate_nrows)
let s_suppkey = load('s_suppkey', [], [150])
let s_city = load('s_city', [s_suppkey], [131,150])
let s_nation = select(load('s_nation', [s_city], [25,131]), [17], 0)
let res4 = contract('e,fe,gf->ef', s_suppkey, s_city, s_nation)
let supplierProb = res4
let d_datekey = load('d_datekey', [], [147])
let d_yearmonth = load('d_yearmonth', [d_datekey], [80,147])
let d_yearmonthnum = load('d_yearmonthnum', [d_yearmonth], [77,80])
let d_year = select(load('d_year', [d_yearmonthnum], [7,77]), [5, 6], 0)
let res6 = contract('h,ih,ji,kj->hk', d_datekey, d_yearmonth, d_yearmonthnum, d_year)
let dwdateProb = res6
let p_partkey = load('p_partkey', [], [150])
let p_name = load('p_name', [p_partkey], [150,150])
let p_brand1 = load('p_brand1', [p_name], [145,150])
let p_category = select(load('p_category', [p_brand1], [25,145]), [15], 0)
let res8 = contract('l,ml,nm,on->ln', p_partkey, p_name, p_brand1, p_category)
let partProb = res8
let lo_orderkey = load('lo_orderkey', [], [150])
let lo_supplycost = load('lo_supplycost', [lo_orderkey], [200,150])
let lo_suppkey = load('lo_suppkey', [lo_supplycost], [150,200])
let lo_partkey = load('lo_partkey', [lo_supplycost], [150,200])
let lo_extendedprice = load('lo_extendedprice', [lo_supplycost], [200,200])
let lo_revenue = load('lo_revenue', [lo_extendedprice], [200,200])
let lo_custkey = load('lo_custkey', [lo_revenue], [150,200])
let lo_ordertotalprice = load('lo_ordertotalprice', [lo_revenue], [200,200])
let lo_orderdate = load('lo_orderdate', [lo_ordertotalprice], [148,200])
let res10 = contract('p,qp,rq,sq,tq,ut,vu,wu,xw->rsvxu', lo_orderkey, lo_supplycost, lo_suppkey, lo_partkey, lo_extendedprice, lo_revenue, lo_custkey, lo_ordertotalprice, lo_orderdate)
let lineorderProb = res10
let lo_revenue_m = load('lo_revenue_m', [], [200])
let lo_custkey_c_custkey = load('lo_custkey_c_custkey', [], [150,150])
let lo_suppkey_s_suppkey = load('lo_suppkey_s_suppkey', [], [150,150])
let lo_orderdate_d_datekey = load('lo_orderdate_d_datekey', [], [148,147])
let lo_partkey_p_partkey = load('lo_partkey_p_partkey', [], [150,150])
let lineorderPr_0 = contract('rsvxu,a->rsvxua', lineorderProb, customerProb)
let lineorderPr_1 = contract('rsvxua,va->ursx', lineorderPr_0, lo_custkey_c_custkey)
let lineorderPr_1 = contract('ursx,ef->ursxef', lineorderPr_1, supplierProb)
let lineorderPr_2 = contract('ursxef,re->usxf', lineorderPr_1, lo_suppkey_s_suppkey)
let lineorderPr_2 = contract('usxf,hk->usxfhk', lineorderPr_2, dwdateProb)
let lineorderPr_3 = contract('usxfhk,xh->usfk', lineorderPr_2, lo_orderdate_d_datekey)
let lineorderPr_3 = contract('usfk,ln->usfkln', lineorderPr_3, partProb)
let lineorderPr_4 = contract('usfkln,sl->ufkn', lineorderPr_3, lo_partkey_p_partkey)
let lineorderPr_4Norm = normalize(lineorderPr_4, [])
let exp_lo_revenue = contract('ufkn,u->nkf', lineorderPr_4Norm, lo_revenue_m)
let lineorderPr_4_um = ones('lineorderPr_4', 4, [200,150,2,150])
let lineorderPr_4_count = contract('ufkn,ufkn->nkf', lineorderPr_4, lineorderPr_4_um)
let count_lo_revenue = contract(',nkf->nkf', nrows, lineorderPr_4_count)
let sum_lo_revenue = contract('nkf,nkf->nkf', exp_lo_revenue, count_lo_revenue)
sum_lo_revenue