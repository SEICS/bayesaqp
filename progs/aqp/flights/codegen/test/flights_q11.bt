let flights_year_date = loadDiscrete('flights_year_date_cpd', [], [22]) in
let flights_distance = loadDiscrete('flights_distance_cpd', [flights_year_date], [3000, 22]) in
let flights_air_time = loadDiscrete('flights_air_time_cpd', [flights_distance], [1858, 3000]) in
let flights_arr_delay = loadDiscrete('flights_arr_delay_cpd', [flights_distance], [971, 3000]) in
let flights_taxi_out = loadDiscrete('flights_taxi_out_cpd', [flights_distance], [428, 3000]) in
let flights_origin = loadDiscrete('flights_origin_cpd', [flights_distance], [372, 3000]) in
let flights_dest = loadDiscrete('flights_dest_cpd', [flights_distance], [372, 3000]) in
let flights_taxi_in = loadDiscrete('flights_taxi_in_cpd', [flights_distance], [255, 3000]) in
let flights_unique_carrier = loadDiscrete('flights_unique_carrier_cpd', [flights_distance], [26, 3000]) in
let flights_dep_delay = loadDiscrete('flights_dep_delay_cpd', [flights_arr_delay], [750, 971]) in
let flights_origin_state_abr = loadDiscrete('flights_origin_state_abr_cpd', [flights_origin], [53, 372]) in
let flights_dest_state_abr = loadDiscrete('flights_dest_state_abr_cpd', [flights_dest], [53, 372]) in

let flights_unique_carrier_ = select flights_unique_carrier [3] in
let flights_origin_ = select flights_origin [0] in
let flightsProb0 = query [flights_taxi_out, flights_dest_state_abr] [flights_unique_carrier_, flights_origin_] [] [] in

let taxi_out_m = loadTensor('taxi_out_m', [428]) in
let nrows = 1000000000 in
let flights_unique_carrier_ = select flights_unique_carrier [3] in
let flights_origin_ = select flights_origin [0] in
let flightsProb1 = query [flights_taxi_in, flights_dest_state_abr] [flights_unique_carrier_, flights_origin_] [] [] in

let taxi_in_m = loadTensor('taxi_in_m', [255]) in
let flightsProb0Norm = normalize flightsProb0 [1] in
let exp_taxi_out = expectation [flights_dest_state_abr] flightsProb0Norm taxi_out_m [0] in

let flightsProb0_um = unitMat flightsProb0 in
let flightsProb0_count = expectation [flights_dest_state_abr] flightsProb0 flightsProb0_um [0, 1] in
let count_taxi_out = nrows * flightsProb0_count in
let sum_taxi_out = exp_taxi_out * count_taxi_out in

let flightsProb1Norm = normalize flightsProb1 [1] in
let exp_taxi_in = expectation [flights_dest_state_abr] flightsProb1Norm taxi_in_m [0] in

let flightsProb1_um = unitMat flightsProb1 in
let flightsProb1_count = expectation [flights_dest_state_abr] flightsProb1 flightsProb1_um [0, 1] in
let count_taxi_in = nrows * flightsProb1_count in
let sum_taxi_in = exp_taxi_in * count_taxi_in in

let res0 = sum_taxi_out - sum_taxi_in in
let flights_dest_state_abr_b2v = loadDictionary('flights_dest_state_abr_b2v', [53, 53]) in

let res0rev = map res0 [flights_dest_state_abr_b2v] in
let res0rev_lift = lift res0rev in
res0rev_lift