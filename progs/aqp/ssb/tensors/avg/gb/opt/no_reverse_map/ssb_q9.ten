let res10 = contract('r,sr,ts,ut,vu,wu,xw,ys,zs,a,za,fh,vf,j,yj,nq,xn->uhq', lo_orderkey, lo_supplycost, lo_extendedprice, lo_revenue, lo_custkey, lo_ordertotalprice, lo_orderdate, lo_suppkey, lo_partkey, partProb, lo_partkey_p_partkey, customerProb, lo_custkey_c_custkey, supplierProb, lo_suppkey_s_suppkey, dwdateProb, lo_orderdate_d_datekey)
let lineorderProb = res10

let lineorderPr_4Norm = normalize(lineorderProb, [1,2])
let exp_lo_revenue = contract('uhq,u->qh', lineorderPr_4Norm, lo_revenue_m)
exp_lo_revenue
