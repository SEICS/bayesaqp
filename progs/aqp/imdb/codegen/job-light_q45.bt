let movie_info_id = loadDiscrete('movie_info_id_cpd', [], [1500]) in
let movie_info_movie_id = loadDiscrete('movie_info_movie_id_cpd', [movie_info_id], [1500, 1500]) in
let movie_info_info_type_id = loadDiscrete('movie_info_info_type_id_cpd', [movie_info_id], [71, 1500]) in
let movie_info_idx_id = loadDiscrete('movie_info_idx_id_cpd', [], [1500]) in
let movie_info_idx_movie_id = loadDiscrete('movie_info_idx_movie_id_cpd', [movie_info_idx_id], [1499, 1500]) in
let movie_info_idx_info_type_id = loadDiscrete('movie_info_idx_info_type_id_cpd', [movie_info_idx_id], [5, 1500]) in
let title_id = loadDiscrete('title_id_cpd', [], [1500]) in
let title_kind_id = loadDiscrete('title_kind_id_cpd', [title_id], [11, 1500]) in
let title_production_year = loadDiscrete('title_production_year_cpd', [title_id], [132, 1500]) in
let cast_info_id = loadDiscrete('cast_info_id_cpd', [], [1500]) in
let cast_info_role_id = loadDiscrete('cast_info_role_id_cpd', [cast_info_id], [903, 1500]) in
let cast_info_movie_id = loadDiscrete('cast_info_movie_id_cpd', [cast_info_id], [1500, 1500]) in

let movie_info_info_type_id_ = select movie_info_info_type_id [1] in
let movie_infoProb0 = query [movie_info_movie_id] [movie_info_info_type_id_] [] [] in
let title_nrows = 3486660 in
let movie_info_nrows = 24988000 in
let cast_info_nrows = 63475800 in
let movie_info_idx_nrows = 3147110 in
let movie_info_nrows = movie_info_nrows * title_nrows in
let cast_info_nrows = cast_info_nrows * movie_info_nrows in
let nrows = movie_info_idx_nrows * cast_info_nrows in
let movie_info_idx_info_type_id_ = select movie_info_idx_info_type_id [2] in
let movie_info_idxProb0 = query [movie_info_idx_movie_id] [movie_info_idx_info_type_id_] [] [] in
let cast_infoProb0 = query [cast_info_movie_id] [] [] [] in
let title_production_year_ = select title_production_year [0, 1, 2, 3, 10] in
let titleProb0 = query [title_id] [title_production_year_] [] [] in
let m3_title_movie_info = loadTensor('title_id_movie_info_movie_id_pkfk', [1500, 1500]) in
let m3_title_movie_info_idx = loadTensor('title_id_movie_info_idx_movie_id_pkfk', [1500, 1499]) in
let m3_title_cast_info = loadTensor('title_id_cast_info_movie_id_pkfk', [1500, 1500]) in
let titleProb0_0 = outer titleProb0 cast_infoProb0 in
let titleProb0_1 = expectation [title_id] titleProb0_0 m3_title_cast_info [0, 1] in
let titleProb0_2 = outer titleProb0_1 movie_info_idxProb0 in
let titleProb0_3 = expectation [title_id] titleProb0_2 m3_title_movie_info_idx [0, 1] in
let titleProb0_4 = outer titleProb0_3 movie_infoProb0 in
let titleProb0_5 = expectation [] titleProb0_4 m3_title_movie_info [0, 1] in

let titleProb0_5_tensor = tensor titleProb0_5 in
let count_ = nrows * titleProb0_5_tensor in

count_