let p_partkey = load('p_partkey', [], [150])
let p_name = load('p_name', [p_partkey], [150,150])
let p_brand1 = load('p_brand1', [p_name], [145,150])
let p_category = load('p_category', [p_brand1], [25,145])
let p_mfgr = select(load('p_mfgr', [p_category], [5,25]), [2, 4], 0)
let res2 = contract('a,ba,cb,dc,ed->a', p_partkey, p_name, p_brand1, p_category, p_mfgr)
let partProb = res2
let lineorder_nrows = tensor(0, [], [26662.0])
let part_nrows = tensor(0, [], [600000.0])
let supplier_nrows = tensor(0, [], [10000.0])
let customer_nrows = tensor(0, [], [150000.0])
let dwdate_nrows = tensor(0, [], [2556.0])
let part_nrows = contract(',->', part_nrows, lineorder_nrows)
let supplier_nrows = contract(',->', supplier_nrows, part_nrows)
let customer_nrows = contract(',->', customer_nrows, supplier_nrows)
let nrows = contract(',->', dwdate_nrows, customer_nrows)
let c_custkey = load('c_custkey', [], [150])
let c_city = load('c_city', [c_custkey], [131,150])
let c_nation = load('c_nation', [c_city], [25,131])
let c_region = select(load('c_region', [c_nation], [5,25]), [2], 0)
let res4 = contract('f,gf,hg,ih->f', c_custkey, c_city, c_nation, c_region)
let customerProb = res4
let s_suppkey = load('s_suppkey', [], [150])
let s_city = load('s_city', [s_suppkey], [131,150])
let s_nation = load('s_nation', [s_city], [25,131])
let s_region = select(load('s_region', [s_nation], [5,25]), [0], 0)
let res6 = contract('j,kj,lk,ml->j', s_suppkey, s_city, s_nation, s_region)
let supplierProb = res6
let d_datekey = load('d_datekey', [], [147])
let res8 = contract('n->n', d_datekey)
let dwdateProb = res8
let lo_orderkey = load('lo_orderkey', [], [150])
let lo_supplycost = load('lo_supplycost', [lo_orderkey], [200,150])
let lo_partkey = load('lo_partkey', [lo_supplycost], [150,200])
let lo_extendedprice = load('lo_extendedprice', [lo_supplycost], [200,200])
let lo_revenue = load('lo_revenue', [lo_extendedprice], [200,200])
let lo_custkey = load('lo_custkey', [lo_revenue], [150,200])
let lo_ordertotalprice = load('lo_ordertotalprice', [lo_revenue], [200,200])
let lo_orderdate = load('lo_orderdate', [lo_ordertotalprice], [148,200])
let lo_suppkey = load('lo_suppkey', [lo_supplycost], [150,200])
let res10 = contract('o,po,qp,rp,sr,ts,us,vu,wp->qtvws', lo_orderkey, lo_supplycost, lo_partkey, lo_extendedprice, lo_revenue, lo_custkey, lo_ordertotalprice, lo_orderdate, lo_suppkey)
let lineorderProb = res10
let lo_revenue_m = load('lo_revenue_m', [], [200])
let lo_partkey_p_partkey = load('lo_partkey_p_partkey', [], [150,150])
let lo_custkey_c_custkey = load('lo_custkey_c_custkey', [], [150,150])
let lo_suppkey_s_suppkey = load('lo_suppkey_s_suppkey', [], [150,150])
let lo_orderdate_d_datekey = load('lo_orderdate_d_datekey', [], [148,147])
let lineorderPr_0 = contract('qtvws,a->qtvwsa', lineorderProb, partProb)
let lineorderPr_1 = contract('qtvwsa,qa->stvw', lineorderPr_0, lo_partkey_p_partkey)
let lineorderPr_1 = contract('stvw,f->stvwf', lineorderPr_1, customerProb)
let lineorderPr_2 = contract('stvwf,tf->svw', lineorderPr_1, lo_custkey_c_custkey)
let lineorderPr_2 = contract('svw,j->svwj', lineorderPr_2, supplierProb)
let lineorderPr_3 = contract('svwj,wj->sv', lineorderPr_2, lo_suppkey_s_suppkey)
let lineorderPr_3 = contract('sv,n->svn', lineorderPr_3, dwdateProb)
let lineorderPr_4 = contract('svn,vn->s', lineorderPr_3, lo_orderdate_d_datekey)
let lineorderPr_4Norm = normalize(lineorderPr_4, [])
let exp_lo_revenue = contract('s,s->', lineorderPr_4Norm, lo_revenue_m)
exp_lo_revenue
